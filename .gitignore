# ============================================================================
# PlantSafety (application repo) .gitignore
# Standard .NET build output + tooling artifacts, matching the convention the
# parent workspace tree already uses.
#
# Added 2026-08-10: this repo previously had no .gitignore at all, so ~9,200
# bin/obj artifacts and the .vs/ cache had been committed. Those are untracked
# in the same change that added this file (git rm --cached -- working copies
# on disk are left untouched).
# ============================================================================

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / IntelliJ
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# MSBuild / dotnet
*.binlog
*.dotCover

# OS files
.DS_Store
Thumbs.db

# Rider/VS temp
*.tmp
*.bak
*.swp
*~

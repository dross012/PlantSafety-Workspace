# ============================================================================
# PlantSafety .gitignore
# Standard .NET build output + tooling artifacts. Golden-file snapshots
# under __snapshots__/ are intentionally NOT ignored (Shared.SnapshotTesting,
# Phase 2.10) -- they are committed, reviewed baselines, not build output.
# ============================================================================

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Locally-run operator drill evidence (CI uploads its own copy as a build artifact)
/snapshot-drill-evidence.json
/governance-drill-evidence.json
/canary-rollout-drill-evidence.json

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / IntelliJ
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# MSBuild / dotnet
*.binlog
*.dotCover

# OS files
.DS_Store
Thumbs.db

# Rider/VS temp
*.tmp
*.bak
*.swp
*~

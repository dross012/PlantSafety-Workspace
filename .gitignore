# ============================================================================
# PlantSafety .gitignore
# Standard .NET build output + tooling artifacts. Golden-file snapshots
# under __snapshots__/ are intentionally NOT ignored (Shared.SnapshotTesting,
# Phase 2.10) -- they are committed, reviewed baselines, not build output.
# ============================================================================

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / IntelliJ
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# MSBuild / dotnet
*.binlog
*.dotCover

# OS files
.DS_Store
Thumbs.db

# Rider/VS temp
*.tmp
*.bak
*.swp
*~

# Nested repositories with their own GitHub remotes - tracked there, not here:
#   PlantSafety/        -> github.com/dross012/PlantSafety (the solution)
#   SafetyIntegrations/ -> github.com/dross012/SafetyIntegrations
#   SafetyTooling/      -> github.com/dross012/SafetyTooling
/PlantSafety/
/SafetyIntegrations/
/SafetyTooling/

# dotnet publish output
publish/

# Visual Studio per-user state and scratch tree listings (untracked 2026-10-28; files remain on disk)
.vs/
FullTree.txt
NoFiles.txt

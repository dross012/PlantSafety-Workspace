{
  "Bootstrapper": {
    "Logging": {
      "LogDirectory": "%PROGRAMDATA%/PlantClientInstaller/Logs",
      "Level": "Info"
    },

    "Installer": {
      "ManifestPath": "InstallConfig/installer.json",
      "PayloadRoot": "Payload",
      "ScriptsRoot": "Scripts",
      "UpgradeRoot": "Upgrade",
      "ToolsRoot": "Tools"
    },

    "Execution": {
      "DefaultAction": "install",
      "AllowUninstall": true,
      "AllowUpgrade": true
    },

    "Environment": {
      "RequireAdmin": true,
      "Require64Bit": true,
      "MinDiskSpaceGB": 2
    }
  }
}

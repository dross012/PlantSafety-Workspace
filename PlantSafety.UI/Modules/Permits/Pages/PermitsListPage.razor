@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Permits to Work list page. Loads records from the real
     GET api/v1/operational/permits-to-work read-model endpoint for the
     active tenant/date-range, populates PermitsState, and renders the grid
     with status indicators, search, date-range filtering, and client-side
     pagination (the endpoint has no server-side paging). Built entirely
     from the canonical Shared component library, following the
     Modules/Alerts/Pages/AlertsListPage.razor exemplar pattern.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/permits"

@inject PermitsState State
@inject PermitsApiClient ApiClient
@inject NavigationState NavState
@inject TenantState TenantCtx
@inject UserSessionState UserSession

@implements IDisposable

@using PlantSafety.UI.Modules.Permits.ApiClients
@using PlantSafety.UI.Modules.Permits.Models
@using PlantSafety.UI.Modules.Permits.Services
@using PlantSafety.UI.Modules.Permits.State

<PageTitle>Permits to Work — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Permits to Work list could not be displayed." OnRetry="LoadAsync">

        <div class="ps-page-actions">
            <a href="@RouteDefinitions.PermitCreate" class="ps-btn ps-btn-primary ps-btn-sm">
                <span class="bi bi-plus-lg" aria-hidden="true"></span> New Permit
            </a>
            <SearchBoxComponent Value="State.SearchText" Placeholder="Search permit type, work, or status" ValueChanged="OnSearchChangedAsync" />
            <DateRangePickerComponent StartDate="State.StartDate" EndDate="State.EndDate" RangeChanged="OnRangeChangedAsync" />
            <button class="ps-btn ps-btn-ghost ps-btn-sm" @onclick="LoadAsync" disabled="@State.IsLoadingList">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.ListError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.ListError</div>
        }

        @if (State.IsLoadingList)
        {
            <LoadingIndicatorComponent Message="Loading permit records…" />
        }
        else
        {
            <DataGridComponent TItem="PermitDto"
                                Items="State.PagedItems"
                                Headers="_headers"
                                KeySelector="i => i.PermitId"
                                EmptyMessage="No permit records found for the selected range."
                                AriaLabel="Permits to Work records">
                <RowTemplate Context="item">
                    <td><span class="ps-chip">@item.PermitType</span></td>
                    <td>@item.WorkDescription</td>
                    <td><StatusIndicatorComponent Status="@PermitsUiService.MapStatusToOperationalState(item.Status)" Label="@item.Status" /></td>
                    <td>@item.IssuedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a href="@RouteDefinitions.PermitsList/@item.PermitId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                    </td>
                </RowTemplate>
            </DataGridComponent>

            @if (State.TotalPages > 1)
            {
                <PaginationComponent CurrentPage="State.CurrentPage"
                                      TotalPages="State.TotalPages"
                                      TotalCount="State.TotalCount"
                                      PageChanged="OnPageChangedAsync" />
            }
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Permit Type", "Work", "Status", "Issued", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Permits to Work",
            activeModuleCode: "permits",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Permits to Work" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        State.BeginListLoad();

        var tenantId = ResolveTenantId();
        var fromUtc = State.StartDate.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
        var toUtc = State.EndDate.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Utc);

        var envelope = await ApiClient.GetPermitsToWorkAsync(tenantId, siteId: null, fromUtc, toUtc);

        if (envelope.IsSuccess)
            State.SetItems(envelope.Data!.Items);
        else if (envelope.IsProblem)
            State.SetListError(DescribeProblem(envelope.Problem!));
        else
            State.SetListError($"Failed to load permit records: {envelope.FaultType}");
    }

    private Guid ResolveTenantId() => TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;

    private async Task OnSearchChangedAsync(string text)
    {
        State.SetSearchText(text);
        await Task.CompletedTask;
    }

    private async Task OnRangeChangedAsync((DateOnly Start, DateOnly End) range)
    {
        State.SetDateRange(range.Start, range.End);
        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        State.SetPage(page);
        await Task.CompletedTask;
    }

    private static string DescribeProblem(PlantSafety.UI.Models.Common.ProblemDetailsDto problem) =>
        string.IsNullOrWhiteSpace(problem.Detail) ? "The request failed." : problem.Detail;

    public void Dispose() => State.OnChange -= StateHasChanged;
}

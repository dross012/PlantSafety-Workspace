@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Predictive Safety prediction detail page. The read-model
     endpoint has no by-id GET, so the detail view ensures the parent
     prediction window is loaded (via PredictiveSafetyState) and looks the
     record up client-side by PredictionId — the natural single-entity
     drilldown for this module.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/predictive-safety/{PredictionId:guid}"

@inject PredictiveSafetyState State
@inject PredictiveSafetyApiClient ApiClient
@inject UserSessionState UserSession
@inject TenantState TenantCtx
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.PredictiveSafety.ApiClients

<PageTitle>Prediction Detail — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The prediction detail could not be displayed.">

        @if (_isLoading)
        {
            <LoadingIndicatorComponent Message="Loading prediction…" />
        }
        else if (_notFound)
        {
            <div class="ps-alert ps-alert--danger" role="alert">
                Prediction @PredictionId was not found in the current 90-day window.
                Try widening the date range on the Predictive Safety dashboard.
            </div>
        }
        else if (State.Selected is { } prediction)
        {
            <div class="ps-detail-card">
                <div class="ps-detail-header">
                    <h2 class="ps-detail-title">@prediction.RiskCategory Risk Prediction</h2>
                    <SeverityBadgeComponent Severity="@RiskSeverity(prediction.PredictedRiskScore)" Text="@($"{prediction.PredictedRiskScore:P0}")" />
                    <StatusIndicatorComponent Status="@MapStatus(prediction.Status)" Label="@prediction.Status" />
                </div>

                <dl class="ps-detail-fields">
                    <dt>Prediction ID</dt>   <dd class="ps-mono">@prediction.PredictionId</dd>
                    <dt>Risk Category</dt>   <dd>@prediction.RiskCategory</dd>
                    <dt>Predicted Risk</dt>  <dd>@prediction.PredictedRiskScore.ToString("P0")</dd>
                    <dt>Model Version</dt>   <dd>@(prediction.ModelVersion ?? "—")</dd>
                    <dt>Status</dt>          <dd>@prediction.Status</dd>
                    <dt>Predicted</dt>       <dd>@prediction.PredictedAtUtc.ToString("u") UTC</dd>
                    <dt>Generated By</dt>    <dd class="ps-mono">@prediction.GeneratedBy</dd>
                    @if (prediction.SiteId.HasValue)
                    {
                        <dt>Site</dt><dd class="ps-mono">@prediction.SiteId</dd>
                    }
                </dl>

                <div class="ps-detail-actions">
                    <button class="ps-btn ps-btn-ghost" @onclick="() => Nav.NavigateTo(RouteDefinitions.PredictiveSafetyDashboard)">
                        <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to Predictive Safety
                    </button>
                </div>
            </div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    [Parameter] public Guid PredictionId { get; set; }

    private bool _isLoading;
    private bool _notFound;

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Prediction Detail",
            activeModuleCode: "predictive-safety",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Predictive Safety", Href = RouteDefinitions.PredictiveSafetyDashboard },
                new BreadcrumbItem { Label = "Prediction Detail" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (State.SelectById(PredictionId))
            return;

        _isLoading = true;
        StateHasChanged();

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var from = State.RangeStart.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
        var to = State.RangeEnd.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Utc);

        var envelope = await ApiClient.GetPredictionsAsync(tenantId, siteId: null, from, to);

        if (envelope.IsSuccess)
            State.SetPredictions(envelope.Data!.Items);

        _notFound = !State.SelectById(PredictionId);
        _isLoading = false;
    }

    private static string RiskSeverity(double score) => score switch
    {
        >= 0.85 => "Critical",
        >= 0.7 => "High",
        >= 0.4 => "Medium",
        _ => "Low",
    };

    private static string MapStatus(string status) => status.ToLowerInvariant() switch
    {
        "resolved" => "Healthy",
        "acknowledged" => "Warning",
        "active" => "Critical",
        _ => "Offline",
    };

    public void Dispose() => State.OnChange -= StateHasChanged;
}

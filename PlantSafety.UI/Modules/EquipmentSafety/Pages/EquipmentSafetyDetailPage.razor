@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Equipment Safety detail page. The read-model API exposes
     only a list endpoint (GET api/v1/operational/equipment-safety, no
     GetById) — the record is resolved from the already-loaded
     EquipmentSafetyState.AllItems when navigated to from the list, or by
     re-querying a wide date window when deep-linked directly. Tabbed
     workspace (header/summary/actions shape loosely borrowed from the
     Equipment Detail Wireframe Spec ED1) built entirely from the canonical
     Shared component library: ErrorBoundaryComponent, LoadingIndicatorComponent,
     TabControlComponent, CardComponent, StatusIndicatorComponent.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/equipment-safety/{EquipmentSafetyRecordId:guid}"

@inject EquipmentSafetyState State
@inject EquipmentSafetyApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav
@inject TenantState TenantCtx
@inject UserSessionState UserSession

@implements IDisposable

@using PlantSafety.UI.Modules.EquipmentSafety.ApiClients
@using PlantSafety.UI.Modules.EquipmentSafety.Models
@using PlantSafety.UI.Modules.EquipmentSafety.Services
@using PlantSafety.UI.Modules.EquipmentSafety.State

<PageTitle>Equipment Safety Detail — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The equipment safety detail could not be displayed.">

        @if (State.IsLoadingDetail)
        {
            <LoadingIndicatorComponent Message="Loading equipment safety record…" />
        }
        else if (State.DetailError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.DetailError</div>
        }
        else if (State.SelectedItem is { } record)
        {
            <div class="ps-detail-header">
                <h2 class="ps-detail-title">@record.EquipmentName</h2>
                <StatusIndicatorComponent Status="@EquipmentSafetyUiService.MapStatusToOperationalState(record.Status)" Label="@record.Status" />
            </div>

            <TabControlComponent Tabs="_tabLabels" ActiveIndex="_activeTab" ActiveIndexChanged="OnTabChanged" AriaLabel="Equipment Safety record sections" />

            <div class="ps-tab-panel" role="tabpanel">

                @if (_activeTab == 0)
                {
                    <CardComponent Title="Overview">
                        <div class="ps-field-row"><span class="ps-field-label">Equipment</span><span class="ps-field-value">@record.EquipmentName</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Equipment ID</span><span class="ps-field-value ps-mono">@record.EquipmentId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Status</span><span><StatusIndicatorComponent Status="@EquipmentSafetyUiService.MapStatusToOperationalState(record.Status)" Label="@record.Status" /></span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Last Inspected</span><span class="ps-field-value">@record.InspectedAtUtc.ToString("u") UTC</span></div>
                    </CardComponent>
                }

                @if (_activeTab == 1)
                {
                    <CardComponent Title="Record Detail">
                        <div class="ps-field-row"><span class="ps-field-label">Record ID</span><span class="ps-field-value ps-mono">@record.EquipmentSafetyRecordId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Tenant ID</span><span class="ps-field-value ps-mono">@record.TenantId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Site ID</span><span class="ps-field-value ps-mono">@(record.SiteId?.ToString() ?? "All sites")</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Inspected By</span><span class="ps-field-value ps-mono">@record.InspectedBy</span></div>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            Hazard checklist, control-measure verification, and PPE requirements need backend
                            wiring — the Equipment Safety read-model endpoint returns only the summary fields
                            shown here today.
                        </p>
                    </CardComponent>
                }

                @if (_activeTab == 2)
                {
                    <CardComponent Title="Actions &amp; Audit">
                        <button class="ps-btn ps-btn-ghost ps-btn-sm" @onclick="() => Nav.NavigateTo(RouteDefinitions.EquipmentSafetyList)">
                            <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to Equipment Safety
                        </button>
                        <button class="ps-btn ps-btn-primary ps-btn-sm" disabled aria-label="Log inspection">
                            <span class="bi bi-clipboard-check" aria-hidden="true"></span> Log Inspection
                        </button>
                        <button class="ps-btn ps-btn-primary ps-btn-sm" disabled aria-label="Report defect">
                            <span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Report Defect
                        </button>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            Logging a new inspection or defect report needs backend wiring — no command
                            endpoint exists yet for the Equipment Safety module (read-only today).
                        </p>
                    </CardComponent>
                }

            </div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _tabLabels = ["Overview", "Record Detail", "Actions & Audit"];
    private int _activeTab;

    [Parameter] public Guid EquipmentSafetyRecordId { get; set; }

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Equipment Safety Detail",
            activeModuleCode: "equipment-safety",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Equipment Safety", Href = RouteDefinitions.EquipmentSafetyList },
                new BreadcrumbItem { Label = "Detail" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ResolveRecordAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (State.SelectedItem is { } current && current.EquipmentSafetyRecordId == EquipmentSafetyRecordId)
            return;

        await ResolveRecordAsync();
    }

    private async Task ResolveRecordAsync()
    {
        State.BeginDetailLoad();

        var existing = State.AllItems.FirstOrDefault(i => i.EquipmentSafetyRecordId == EquipmentSafetyRecordId);
        if (existing is not null)
        {
            State.SetSelectedItem(existing);
            return;
        }

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var fromUtc = DateTime.UtcNow.AddYears(-2);
        var toUtc = DateTime.UtcNow;

        var envelope = await ApiClient.GetEquipmentSafetyAsync(tenantId, siteId: null, fromUtc, toUtc);

        if (envelope.IsSuccess)
        {
            var found = envelope.Data!.Items.FirstOrDefault(i => i.EquipmentSafetyRecordId == EquipmentSafetyRecordId);
            if (found is not null)
                State.SetSelectedItem(found);
            else
                State.SetDetailError("This equipment safety record could not be found.");
        }
        else if (envelope.IsProblem)
        {
            State.SetDetailError(string.IsNullOrWhiteSpace(envelope.Problem!.Detail) ? "The request failed." : envelope.Problem!.Detail);
        }
        else
        {
            State.SetDetailError($"Failed to load equipment safety record: {envelope.FaultType}");
        }
    }

    private Task OnTabChanged(int index)
    {
        _activeTab = index;
        return Task.CompletedTask;
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

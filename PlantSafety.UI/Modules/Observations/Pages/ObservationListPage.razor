@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Observation list page. The backend does not yet expose a
     list endpoint for Observations (Create/Update/GetById only) — this page
     calls the conventional collection route via ObservationApiClient and
     degrades gracefully to the standard error/empty state via
     ErrorBoundaryComponent until that endpoint ships (Loading/Error/Empty/
     Ready state machine per UI Agent instructions).
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/observations"

@inject ObservationState State
@inject ObservationApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.Observations.State
@using PlantSafety.UI.Modules.Observations.ApiClients
@using PlantSafety.UI.Modules.Observations.Mappings
@using PlantSafety.UI.Modules.Observations.Models

<PageTitle>Observations — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Observations list could not be displayed." OnRetry="LoadPageAsync">

        <div class="ps-page-actions">
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadPageAsync" disabled="@State.IsLoadingList">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.ListError is not null)
        {
            <div class="ps-alert ps-alert--warning" role="alert">
                @State.ListError
                <p class="ps-needs-backend">
                    <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                    The Observations list needs backend wiring — no list endpoint exists yet
                    (only Create/Update/GetById are available today). Use a direct link to
                    <code>/modules/observations/&#123;id&#125;</code> to view a known record.
                </p>
            </div>
        }

        @if (State.IsLoadingList)
        {
            <LoadingIndicatorComponent Message="Loading observations…" />
        }
        else if (State.ListError is null)
        {
            <DataGridComponent TItem="ObservationDto"
                                Items="State.Items"
                                Headers="_headers"
                                KeySelector="o => o.ObservationId"
                                EmptyMessage="No observations found."
                                AriaLabel="Observations">
                <RowTemplate Context="item">
                    @{ var vm = item.ToViewModel(); }
                    <td><SeverityBadgeComponent Severity="@vm.SeverityForBadge" Text="@item.ObservationType" /></td>
                    <td>@item.Title</td>
                    <td><StatusIndicatorComponent Status="@vm.OperationalStatus" Label="@item.Status" /></td>
                    <td>@item.ObservedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a href="@RouteDefinitions.ObservationList/@item.ObservationId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                    </td>
                </RowTemplate>
            </DataGridComponent>

            @if (State.TotalPages > 1)
            {
                <PaginationComponent CurrentPage="State.CurrentPage"
                                      TotalPages="State.TotalPages"
                                      TotalCount="State.TotalCount"
                                      PageChanged="GoToPageAsync" />
            }
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Type", "Title", "Status", "Observed", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Observations",
            activeModuleCode: "observations",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Observations" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadPageAsync();
    }

    private async Task LoadPageAsync() => await GoToPageAsync(1);

    private async Task GoToPageAsync(int page)
    {
        State.BeginListLoad();
        var envelope = await ApiClient.ListObservationsAsync(pageNumber: page, pageSize: 25);

        if (envelope.IsSuccess)
            State.SetItems(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetListError(envelope.Problem!.Detail);
        else
            State.SetListError($"Failed to load observations: {envelope.FaultType}");
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-08-05
   FILE DESCRIPTION: Create Safety Observation form. Submits a
     CreateObservationRequest via POST v1/features/safety-events/observations
     (ObservationApiClient.CreateObservationAsync, backed by the real
     CreateObservationCommand) and navigates to the new observation's detail
     page on success. Follows the canonical Blazor UI form pattern
     established in Modules/Financials/Pages/CreateBudgetPage.razor.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/observations/new"

@inject ObservationState State
@inject ObservationApiClient ApiClient
@inject TenantState TenantCtx
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.Observations.ApiClients
@using PlantSafety.UI.Modules.Observations.Models
@using PlantSafety.UI.Modules.Observations.State

<PageTitle>New Observation — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Create Observation form could not be displayed.">

        <div class="ps-detail-header">
            <h2 class="ps-detail-title">Record Safety Observation</h2>
        </div>

        @if (State.CreateError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.CreateError</div>
        }

        <div class="ps-form-card">
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="ps-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="ps-form-error" />

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="title">Title</label>
                        <InputText id="title" @bind-Value="_model.Title" maxlength="200" />
                        <ValidationMessage For="() => _model.Title" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="observation-type">Observation Type</label>
                        <InputSelect id="observation-type" @bind-Value="_model.ObservationType">
                            <option value="Positive">Positive</option>
                            <option value="AtRisk">At Risk</option>
                            <option value="Unsafe">Unsafe</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="description">Description</label>
                        <InputTextArea id="description" @bind-Value="_model.Description" maxlength="4000" />
                        <ValidationMessage For="() => _model.Description" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="site-id">Site Id</label>
                        <InputText id="site-id" @bind-Value="_siteIdText" placeholder="GUID" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="observed-by">Observed By Worker Id</label>
                        <InputText id="observed-by" @bind-Value="_observedByText" placeholder="GUID" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="observed-at">Observed At</label>
                        <InputDate id="observed-at" Type="InputDateType.DateTimeLocal" @bind-Value="_observedAtLocal" />
                    </div>
                </div>

                <div class="ps-form-actions">
                    <button type="submit" class="ps-btn ps-btn-primary" disabled="@State.IsCreating">
                        @if (State.IsCreating)
                        {
                            <span class="bi bi-arrow-repeat" aria-hidden="true"></span> <text>Submitting…</text>
                        }
                        else
                        {
                            <span class="bi bi-check-circle" aria-hidden="true"></span> <text>Record Observation</text>
                        }
                    </button>
                    <button type="button" class="ps-btn ps-btn-ghost" @onclick="NavigateToList" disabled="@State.IsCreating">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>

    </ErrorBoundaryComponent>

</div>

@code {
    private readonly CreateObservationRequest _model = new();
    private string _siteIdText = string.Empty;
    private string _observedByText = string.Empty;
    private DateTime? _observedAtLocal = DateTime.Now;

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Record Safety Observation",
            activeModuleCode: "observations",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Observations", Href = RouteDefinitions.ObservationList },
                new BreadcrumbItem { Label = "New" }
            ]);

        State.ResetCreate();

        var siteId = TenantCtx.Tenant?.SiteId;
        if (siteId is not null)
            _siteIdText = siteId.Value.ToString();

        State.OnChange += StateHasChanged;
    }

    private async Task SubmitAsync()
    {
        if (!Guid.TryParse(_siteIdText, out var siteId))
        {
            State.SetCreateError("Site Id must be a valid GUID.");
            return;
        }

        if (!Guid.TryParse(_observedByText, out var observedById))
        {
            State.SetCreateError("Observed By Worker Id must be a valid GUID.");
            return;
        }

        if (_observedAtLocal is null)
        {
            State.SetCreateError("Observed At date is required.");
            return;
        }

        _model.SiteId = siteId;
        _model.ObservedByWorkerId = observedById;
        _model.ObservedAtUtc = new DateTimeOffset(DateTime.SpecifyKind(_observedAtLocal.Value, DateTimeKind.Utc));

        State.BeginCreate();

        var envelope = await ApiClient.CreateObservationAsync(_model);

        if (envelope.IsSuccess)
        {
            State.SetCreateSuccess(envelope.Data!);
            Nav.NavigateTo($"{RouteDefinitions.ObservationList}/{envelope.Data!}");
        }
        else if (envelope.IsProblem)
        {
            State.SetCreateError(envelope.Problem!.Detail);
        }
        else
        {
            State.SetCreateError($"Failed to record observation: {envelope.FaultType}");
        }
    }

    private void NavigateToList() => Nav.NavigateTo(RouteDefinitions.ObservationList);

    public void Dispose() => State.OnChange -= StateHasChanged;
}

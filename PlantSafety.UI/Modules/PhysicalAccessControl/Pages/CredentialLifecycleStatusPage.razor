@* ============================================================
   AUTHOR: PlantSafety Platform Team
   CREATED: 2026-08-04
   FILE DESCRIPTION: Credential Lifecycle Status dashboard for PhysicalAccessControl. Looks up a
     single credential's (badge's) current lifecycle status (GET credentials/{id}/status) by
     credential ID — the API deliberately exposes only PII-minimal by-ID lookups for credentials,
     never a bulk list, per the module's data-governance mandate. Built entirely from the canonical
     Shared component library.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/physical-access-control/credentials"

@inject PhysicalAccessControlState State
@inject PhysicalAccessControlApiClient ApiClient
@inject NavigationState NavState
@inject UserSessionState UserSession

@implements IDisposable

@using PlantSafety.UI.Modules.PhysicalAccessControl.ApiClients
@using PlantSafety.UI.Modules.PhysicalAccessControl.Models

<PageTitle>Credential Lifecycle Status — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The credential lifecycle status lookup could not be displayed." OnRetry="LookupAsync">

        <div class="ps-page-actions">
            <a href="/modules/physical-access-control" class="ps-btn ps-btn-ghost ps-btn-sm">Anomaly Feed</a>
            <a href="/modules/physical-access-control/occupancy-map" class="ps-btn ps-btn-ghost ps-btn-sm">Access &amp; Occupancy Map</a>
            <div class="ps-form-field">
                <label for="credentialIdInput">Credential ID</label>
                <input id="credentialIdInput" type="text" @bind="_credentialIdInput" placeholder="Enter credential GUID" />
            </div>
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LookupAsync">
                <span class="bi bi-search" aria-hidden="true"></span> Look Up
            </button>
        </div>

        @if (State.CredentialLookupError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.CredentialLookupError</div>
        }

        @if (State.LookedUpCredential is { } credential)
        {
            <CardComponent Title="@($"Badge …{credential.BadgeNumberMasked}")">
                <div class="ps-field-row"><span class="ps-field-label">Status</span> <StatusIndicatorComponent Status="@MapCredentialStatus(credential)" Label="@credential.Status" /></div>
                <div class="ps-field-row"><span class="ps-field-label">Holder Type</span> <span class="ps-field-value">@credential.HolderType</span></div>
                <div class="ps-field-row"><span class="ps-field-label">Access Level</span> <span class="ps-field-value">@credential.AccessLevel</span></div>
                <div class="ps-field-row"><span class="ps-field-label">Issued</span> <span class="ps-field-value">@credential.IssuedAtUtc.ToString("yyyy-MM-dd")</span></div>
                <div class="ps-field-row"><span class="ps-field-label">Expires</span> <span class="ps-field-value">@(credential.ExpiresAtUtc?.ToString("yyyy-MM-dd") ?? "No expiry recorded")</span></div>
            </CardComponent>
        }
        else if (State.CredentialLookupError is null)
        {
            <div class="ps-alert ps-alert--info" role="status">Enter a credential ID above to view its current lifecycle status.</div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private string _credentialIdInput = string.Empty;

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Credential Lifecycle Status",
            activeModuleCode: "physical-access-control",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Physical Access Control", Href = "/modules/physical-access-control" },
                new BreadcrumbItem { Label = "Credential Lifecycle Status" }
            ]);

        State.OnChange += StateHasChanged;
    }

    private async Task LookupAsync()
    {
        if (!Guid.TryParse(_credentialIdInput, out var credentialId))
        {
            State.SetCredentialLookupError("Enter a valid credential GUID before looking it up.");
            return;
        }

        var envelope = await ApiClient.GetCredentialStatusAsync(credentialId);

        if (envelope.IsSuccess)
            State.SetLookedUpCredential(envelope.Data!.Credential);
        else if (envelope.IsProblem)
            State.SetCredentialLookupError(DescribeProblem(envelope.Problem!));
        else
            State.SetCredentialLookupError($"Failed to look up the credential: {envelope.FaultType}");
    }

    private static string DescribeProblem(PlantSafety.UI.Models.Common.ProblemDetailsDto problem) =>
        string.IsNullOrWhiteSpace(problem.Detail) ? "The request failed." : problem.Detail;

    private static string MapCredentialStatus(CredentialStatusDto credential)
    {
        if (credential.ExpiresAtUtc is { } expires && expires < DateTime.UtcNow)
            return "Critical";
        return credential.Status.ToLowerInvariant() switch
        {
            "active" => "Healthy",
            "suspended" => "Warning",
            "revoked" or "expired" => "Critical",
            _ => "Offline",
        };
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

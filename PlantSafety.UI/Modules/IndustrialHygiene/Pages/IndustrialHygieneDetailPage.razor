@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Industrial Hygiene sample detail page. The backend has
     no single-record GetById endpoint — this page reloads the last 90 days
     of records and looks up the requested record client-side.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/industrial-hygiene/{IndustrialHygieneSampleId:guid}"

@inject IndustrialHygieneState State
@inject IndustrialHygieneApiClient ApiClient
@inject TenantState TenantCtx
@inject UserSessionState UserSession
@inject NavigationState NavState
@inject NavigationManager Nav
@inject IJSRuntime JS

@implements IDisposable

@using PlantSafety.UI.Modules.IndustrialHygiene.State
@using PlantSafety.UI.Modules.IndustrialHygiene.ApiClients
@using PlantSafety.UI.Modules.IndustrialHygiene.Mappings
@using PlantSafety.UI.Modules.IndustrialHygiene.Models

<PageTitle>Industrial Hygiene Sample Detail — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The industrial hygiene sample could not be displayed.">

        @if (State.IsLoading)
        {
            <LoadingIndicatorComponent Message="Loading industrial hygiene sample…" />
        }
        else if (State.Error is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.Error</div>
        }
        else if (_record is { } item)
        {
            var vm = item.ToViewModel();
            <div class="ps-detail-card">
                <div class="ps-detail-header">
                    <h2 class="ps-detail-title">Industrial Hygiene Sample</h2>
                    <SeverityBadgeComponent Severity="@vm.SeverityForBadge" Text="@item.ExposureLevel" />
                    <StatusIndicatorComponent Status="@vm.OperationalStatus" Label="@item.Status" />
                </div>

                <CardComponent Title="Summary">
                    <dl class="ps-detail-fields">
                        <dt>Sample Type</dt> <dd>@item.SampleType</dd>
                        <dt>Site</dt>        <dd class="ps-mono">@(item.SiteId?.ToString() ?? "Tenant-wide")</dd>
                        <dt>Sampled</dt>     <dd>@item.SampledAtUtc.ToString("u") UTC</dd>
                        <dt>Sampled By</dt>  <dd class="ps-mono">@item.SampledBy</dd>
                        <dt>Record ID</dt>   <dd class="ps-mono">@item.IndustrialHygieneSampleId</dd>
                    </dl>
                </CardComponent>

                <div class="ps-detail-actions">
                    <button class="ps-btn ps-btn-ghost" @onclick="() => Nav.NavigateTo(RouteDefinitions.IndustrialHygieneList)">
                        <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to Industrial Hygiene
                    </button>
                    <button class="ps-btn ps-btn-ghost" @onclick="PrintAsync">
                        <span class="bi bi-printer" aria-hidden="true"></span> Print
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="ps-alert ps-alert--warning" role="alert">
                No industrial hygiene sample with this identifier was found in the most recent 90-day window.
                <p class="ps-needs-backend">
                    <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                    Industrial Hygiene has no single-record GetById endpoint yet — detail lookup is
                    performed client-side against the date-range read-model.
                </p>
            </div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    [Parameter] public Guid IndustrialHygieneSampleId { get; set; }

    private IndustrialHygieneItemDto? _record;

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Industrial Hygiene Sample Detail",
            activeModuleCode: "industrial-hygiene",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Industrial Hygiene", Href = RouteDefinitions.IndustrialHygieneList },
                new BreadcrumbItem { Label = "Detail" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        State.BeginLoad();

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var envelope = await ApiClient.GetIndustrialHygieneSamplesAsync(
            tenantId,
            siteId: null,
            fromUtc: DateTime.UtcNow.AddDays(-90),
            toUtc: DateTime.UtcNow);

        if (envelope.IsSuccess)
        {
            State.SetItems(envelope.Data!);
            _record = State.Find(IndustrialHygieneSampleId);
        }
        else if (envelope.IsProblem)
        {
            State.SetError(envelope.Problem!.Detail);
        }
        else
        {
            State.SetError($"Failed to load industrial hygiene samples: {envelope.FaultType}");
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    public void Dispose() => State.OnChange -= StateHasChanged;
}

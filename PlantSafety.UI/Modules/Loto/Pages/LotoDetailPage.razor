@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: LOTO detail page. The read-model API exposes only a
     list endpoint (GET api/v1/operational/lockout-tagout, no GetById) — the
     record is resolved from the already-loaded LotoState.AllItems when
     navigated to from the list, or by re-querying a wide date window when
     deep-linked directly. Tabbed step-by-step workspace (isolation points /
     verification / sign-off, per compliance/checklist-heavy module
     guidance) built entirely from the canonical Shared component library:
     ErrorBoundaryComponent, LoadingIndicatorComponent, TabControlComponent,
     CardComponent, StatusIndicatorComponent.
   UPDATED: 2026-08-05 — Wrapped detail content in .ps-detail-card so the
     shared @@media print stylesheet applies, and added a Print action
     (window.print via JS interop). The Operational.LockoutTagout read-model
     has no Create/Update/Delete command reachable from the API (the
     Application-layer LockoutTagout commands under Features/Operational
     exist but are not wired to any controller) — this module is a pure
     read-only projection, so no Edit/Delete actions are offered. Search
     and date-range filtering already exist on the list page.
   SchemaVersion: 2026.2
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/loto/{LockoutTagoutId:guid}"

@inject LotoState State
@inject LotoApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav
@inject TenantState TenantCtx
@inject UserSessionState UserSession
@inject IJSRuntime JS

@implements IDisposable

@using PlantSafety.UI.Modules.Loto.ApiClients
@using PlantSafety.UI.Modules.Loto.Models
@using PlantSafety.UI.Modules.Loto.Services
@using PlantSafety.UI.Modules.Loto.State

<PageTitle>LOTO Detail — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The LOTO detail could not be displayed.">

        @if (State.IsLoadingDetail)
        {
            <LoadingIndicatorComponent Message="Loading LOTO record…" />
        }
        else if (State.DetailError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.DetailError</div>
        }
        else if (State.SelectedItem is { } record)
        {
            <div class="ps-detail-card">
            <div class="ps-detail-header">
                <h2 class="ps-detail-title">Equipment @record.EquipmentId</h2>
                <span class="ps-chip">@record.LockType</span>
                <StatusIndicatorComponent Status="@LotoUiService.MapStatusToOperationalState(record.Status)" Label="@record.Status" />
            </div>

            <TabControlComponent Tabs="_tabLabels" ActiveIndex="_activeTab" ActiveIndexChanged="OnTabChanged" AriaLabel="LOTO record sections" />

            <div class="ps-tab-panel" role="tabpanel">

                @if (_activeTab == 0)
                {
                    <CardComponent Title="Overview">
                        <div class="ps-field-row"><span class="ps-field-label">Equipment</span><span class="ps-field-value ps-mono">@record.EquipmentId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Lock Type</span><span><span class="ps-chip">@record.LockType</span></span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Status</span><span><StatusIndicatorComponent Status="@LotoUiService.MapStatusToOperationalState(record.Status)" Label="@record.Status" /></span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Locked</span><span class="ps-field-value">@record.LockedAtUtc.ToString("u") UTC</span></div>
                    </CardComponent>
                }

                @if (_activeTab == 1)
                {
                    <CardComponent Title="Record Detail">
                        <div class="ps-field-row"><span class="ps-field-label">Record ID</span><span class="ps-field-value ps-mono">@record.LockoutTagoutId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Tenant ID</span><span class="ps-field-value ps-mono">@record.TenantId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Site ID</span><span class="ps-field-value ps-mono">@(record.SiteId?.ToString() ?? "All sites")</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Locked By</span><span class="ps-field-value ps-mono">@record.LockedBy</span></div>
                    </CardComponent>
                }

                @if (_activeTab == 2)
                {
                    <CardComponent Title="Isolation Points &amp; Verification">
                        <p class="ps-field-value">Per-energy-source isolation points (electrical, mechanical, hydraulic,
                            pneumatic, thermal) with zero-energy verification results will render here per module.</p>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            Isolation-point and zero-energy verification tracking needs backend wiring — the LOTO
                            read-model endpoint returns only the summary lock type shown in Overview today.
                        </p>
                    </CardComponent>
                }

                @if (_activeTab == 3)
                {
                    <CardComponent Title="Affected Workers &amp; Sign-off">
                        <button class="ps-btn ps-btn-ghost ps-btn-sm" @onclick="() => Nav.NavigateTo(RouteDefinitions.LotoList)">
                            <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to LOTO
                        </button>
                        <button class="ps-btn ps-btn-primary ps-btn-sm" disabled aria-label="Add crew member lock">
                            <span class="bi bi-lock-fill" aria-hidden="true"></span> Add Crew Lock
                        </button>
                        <button class="ps-btn ps-btn-primary ps-btn-sm" disabled aria-label="Release lockout">
                            <span class="bi bi-unlock" aria-hidden="true"></span> Release Lockout
                        </button>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            Group lockbox / affected-worker sign-off and lock release need backend wiring — no
                            command endpoint exists yet for the LOTO module (read-only today).
                        </p>
                    </CardComponent>
                }

            </div>

            <div class="ps-detail-actions">
                <button class="ps-btn ps-btn-ghost" @onclick="() => Nav.NavigateTo(RouteDefinitions.LotoList)">
                    <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to LOTO
                </button>
                <button class="ps-btn ps-btn-ghost" @onclick="PrintAsync">
                    <span class="bi bi-printer" aria-hidden="true"></span> Print
                </button>
            </div>
            </div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _tabLabels = ["Overview", "Record Detail", "Isolation Points & Verification", "Affected Workers & Sign-off"];
    private int _activeTab;

    [Parameter] public Guid LockoutTagoutId { get; set; }

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "LOTO Detail",
            activeModuleCode: "loto",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "LOTO", Href = RouteDefinitions.LotoList },
                new BreadcrumbItem { Label = "Detail" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ResolveRecordAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (State.SelectedItem is { } current && current.LockoutTagoutId == LockoutTagoutId)
            return;

        await ResolveRecordAsync();
    }

    private async Task ResolveRecordAsync()
    {
        State.BeginDetailLoad();

        var existing = State.AllItems.FirstOrDefault(i => i.LockoutTagoutId == LockoutTagoutId);
        if (existing is not null)
        {
            State.SetSelectedItem(existing);
            return;
        }

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var fromUtc = DateTime.UtcNow.AddYears(-2);
        var toUtc = DateTime.UtcNow;

        var envelope = await ApiClient.GetLockoutTagoutAsync(tenantId, siteId: null, fromUtc, toUtc);

        if (envelope.IsSuccess)
        {
            var found = envelope.Data!.Items.FirstOrDefault(i => i.LockoutTagoutId == LockoutTagoutId);
            if (found is not null)
                State.SetSelectedItem(found);
            else
                State.SetDetailError("This LOTO record could not be found.");
        }
        else if (envelope.IsProblem)
        {
            State.SetDetailError(string.IsNullOrWhiteSpace(envelope.Problem!.Detail) ? "The request failed." : envelope.Problem!.Detail);
        }
        else
        {
            State.SetDetailError($"Failed to load LOTO record: {envelope.FaultType}");
        }
    }

    private Task OnTabChanged(int index)
    {
        _activeTab = index;
        return Task.CompletedTask;
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    public void Dispose() => State.OnChange -= StateHasChanged;
}

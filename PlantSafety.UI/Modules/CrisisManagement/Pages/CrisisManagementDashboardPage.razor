@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Crisis Management dashboard. Event-response command
     center loosely modeled on the Operator Escalation Center wireframe
     (KPI summary + task-queue-style event grid). Calls the real paginated
     List endpoint at /v1/features/safety-events/crisis-events.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/crisis-management"

@inject CrisisManagementState State
@inject CrisisManagementApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.CrisisManagement.State
@using PlantSafety.UI.Modules.CrisisManagement.ApiClients
@using PlantSafety.UI.Modules.CrisisManagement.Mappings
@using PlantSafety.UI.Modules.CrisisManagement.Models

<PageTitle>Crisis Management — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Crisis Management dashboard could not be displayed." OnRetry="LoadPageAsync">

        <div class="ps-page-actions">
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadPageAsync" disabled="@State.IsLoadingList">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        <div class="ps-kpi-row">
            <CardComponent Title="Active Crises" Subtitle="@State.ActiveCount.ToString()" />
            <CardComponent Title="Contained" Subtitle="@State.ContainedCount.ToString()" />
            <CardComponent Title="Resolved" Subtitle="@State.ResolvedCount.ToString()" />
        </div>

        @if (State.ListError is not null)
        {
            <div class="ps-alert ps-alert--warning" role="alert">
                @State.ListError
                <p class="ps-needs-backend">
                    <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                    The Crisis Management event queue needs backend wiring — only the "declare crisis"
                    command endpoint exists today (no list/get-by-id read endpoints yet).
                </p>
            </div>
        }

        @if (State.IsLoadingList)
        {
            <LoadingIndicatorComponent Message="Loading crisis events…" />
        }
        else if (State.ListError is null)
        {
            <CardComponent Title="Crisis Event Queue">
                <DataGridComponent TItem="CrisisEventDto"
                                    Items="State.Items"
                                    Headers="_headers"
                                    KeySelector="c => c.CrisisEventId"
                                    EmptyMessage="No crisis events declared."
                                    AriaLabel="Crisis events">
                    <RowTemplate Context="item">
                        @{ var vm = item.ToViewModel(); }
                        <td><SeverityBadgeComponent Severity="@vm.SeverityForBadge" /></td>
                        <td>@item.Title</td>
                        <td>@item.CrisisCategory</td>
                        <td><StatusIndicatorComponent Status="@vm.OperationalStatus" Label="@item.Status" /></td>
                        <td>@item.DeclaredAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td>
                            <a href="@RouteDefinitions.CrisisManagementDashboard/@item.CrisisEventId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                        </td>
                    </RowTemplate>
                </DataGridComponent>

                @if (State.TotalPages > 1)
                {
                    <PaginationComponent CurrentPage="State.CurrentPage"
                                          TotalPages="State.TotalPages"
                                          TotalCount="State.TotalCount"
                                          PageChanged="GoToPageAsync" />
                }
            </CardComponent>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Severity", "Title", "Category", "Status", "Declared", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Crisis Management",
            activeModuleCode: "crisis-management",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Crisis Management" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadPageAsync();
    }

    private async Task LoadPageAsync() => await GoToPageAsync(1);

    private async Task GoToPageAsync(int page)
    {
        State.BeginListLoad();
        var envelope = await ApiClient.ListCrisisEventsAsync(pageNumber: page, pageSize: 25);

        if (envelope.IsSuccess)
            State.SetItems(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetListError(envelope.Problem!.Detail);
        else
            State.SetListError($"Failed to load crisis events: {envelope.FaultType}");
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

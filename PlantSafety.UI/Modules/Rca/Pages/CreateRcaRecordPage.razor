@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-08-05
   FILE DESCRIPTION: Create (generic) ContinuousImprovement.RCA record.
     Submits a CreateRcaRecordRequest via POST v1/continuous-improvement/rca
     (RcaApiClient.CreateRcaRecordAsync -> CreateRCACommand) and navigates to
     the new record's detail page on success. Distinct, generic RCA
     aggregate from the Incident/NearMiss-linked RCA created via
     CreateRcaPage.razor.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/rca/records/new"

@inject RcaRecordState State
@inject RcaApiClient ApiClient
@inject TenantState TenantCtx
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.Rca.ApiClients
@using PlantSafety.UI.Modules.Rca.Models
@using PlantSafety.UI.Modules.Rca.State

<PageTitle>New RCA Record — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Create RCA Record form could not be displayed.">

        <div class="ps-detail-header">
            <h2 class="ps-detail-title">New RCA Record</h2>
        </div>

        @if (State.CreateError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.CreateError</div>
        }

        <div class="ps-form-card">
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="ps-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="ps-form-error" />

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="problem-statement">Problem Statement</label>
                        <InputTextArea id="problem-statement" @bind-Value="_model.ProblemStatement" rows="3" />
                        <ValidationMessage For="() => _model.ProblemStatement" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="methodology">Methodology</label>
                        <InputText id="methodology" @bind-Value="_model.Methodology" placeholder="e.g. FiveWhys, FishboneDiagram, FaultTree, Bowtie" />
                        <ValidationMessage For="() => _model.Methodology" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-actions">
                    <button type="submit" class="ps-btn ps-btn-primary" disabled="@State.IsCreating">
                        @if (State.IsCreating)
                        {
                            <span class="bi bi-arrow-repeat" aria-hidden="true"></span> <text>Creating…</text>
                        }
                        else
                        {
                            <span class="bi bi-check-circle" aria-hidden="true"></span> <text>Create RCA Record</text>
                        }
                    </button>
                    <button type="button" class="ps-btn ps-btn-ghost" @onclick="NavigateToList" disabled="@State.IsCreating">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>

    </ErrorBoundaryComponent>

</div>

@code {
    private readonly CreateRcaRecordRequest _model = new();

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "New RCA Record",
            activeModuleCode: "rca",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "RCA", Href = RouteDefinitions.RcaList },
                new BreadcrumbItem { Label = "Records", Href = RouteDefinitions.RcaRecordsList },
                new BreadcrumbItem { Label = "New" }
            ]);

        State.ResetCreate();
        _model.SiteId = TenantCtx.Tenant?.SiteId;

        State.OnChange += StateHasChanged;
    }

    private async Task SubmitAsync()
    {
        State.BeginCreate();

        var envelope = await ApiClient.CreateRcaRecordAsync(_model);

        if (envelope.IsSuccess)
        {
            Nav.NavigateTo($"{RouteDefinitions.RcaRecordsList}/{envelope.Data!.RcaId}");
        }
        else if (envelope.IsProblem)
        {
            State.SetCreateError(envelope.Problem!.Detail);
        }
        else
        {
            State.SetCreateError($"Failed to create RCA record: {envelope.FaultType}");
        }
    }

    private void NavigateToList() => Nav.NavigateTo(RouteDefinitions.RcaRecordsList);

    public void Dispose() => State.OnChange -= StateHasChanged;
}

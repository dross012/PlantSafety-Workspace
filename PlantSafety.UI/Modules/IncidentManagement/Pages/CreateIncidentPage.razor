@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-08-05
   FILE DESCRIPTION: Create Incident input form. Submits a CreateIncidentRequest
     via POST v1/features/safety-events/incidents (IncidentManagementApiClient.
     CreateIncidentAsync, backed by the real CreateIncidentCommand) and navigates
     to the new incident's detail page on success. Surfaces every field the real
     backend command accepts: SiteId, Title, Description, IncidentOccurredAtUtc,
     Severity, Location, ReportedByWorkerId, AssignedInvestigatorId. Follows the
     canonical Blazor UI form pattern established in
     Modules/Financials/Pages/CreateBudgetPage.razor.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/incident-management/new"

@inject IncidentManagementApiClient ApiClient
@inject TenantState TenantCtx
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.IncidentManagement.ApiClients
@using PlantSafety.UI.Modules.IncidentManagement.Models

<PageTitle>New Incident — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Create Incident form could not be displayed.">

        <div class="ps-detail-header">
            <h2 class="ps-detail-title">New Incident</h2>
        </div>

        @if (_createError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@_createError</div>
        }

        <div class="ps-form-card">
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="ps-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="ps-form-error" />

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="title">Title</label>
                        <InputText id="title" @bind-Value="_model.Title" maxlength="200" />
                        <ValidationMessage For="() => _model.Title" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="severity">Severity</label>
                        <InputSelect id="severity" @bind-Value="_model.Severity">
                            <option value="Minor">Minor</option>
                            <option value="Moderate">Moderate</option>
                            <option value="Serious">Serious</option>
                            <option value="Critical">Critical</option>
                        </InputSelect>
                        <ValidationMessage For="() => _model.Severity" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="description">Description</label>
                        <InputTextArea id="description" @bind-Value="_model.Description" maxlength="4000" />
                        <ValidationMessage For="() => _model.Description" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="location">Location</label>
                        <InputText id="location" @bind-Value="_model.Location" maxlength="500" />
                        <ValidationMessage For="() => _model.Location" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="site-id">Site Id</label>
                        <InputText id="site-id" @bind-Value="_siteIdText" placeholder="GUID" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="occurred-at">Occurred At (UTC)</label>
                        <InputDate id="occurred-at" Type="InputDateType.DateTimeLocal" @bind-Value="_occurredAtUtc" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="reported-by">Reported By Worker Id</label>
                        <InputText id="reported-by" @bind-Value="_reportedByWorkerIdText" placeholder="GUID" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="assigned-investigator">Assigned Investigator Id (optional)</label>
                        <InputText id="assigned-investigator" @bind-Value="_assignedInvestigatorIdText" placeholder="GUID (optional)" />
                    </div>
                </div>

                <div class="ps-form-actions">
                    <button type="submit" class="ps-btn ps-btn-primary" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="bi bi-arrow-repeat" aria-hidden="true"></span> <text>Creating…</text>
                        }
                        else
                        {
                            <span class="bi bi-check-circle" aria-hidden="true"></span> <text>Create Incident</text>
                        }
                    </button>
                    <button type="button" class="ps-btn ps-btn-ghost" @onclick="NavigateToList" disabled="@_isSubmitting">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>

    </ErrorBoundaryComponent>

</div>

@code {
    private readonly CreateIncidentRequest _model = new();
    private string _siteIdText = string.Empty;
    private string _reportedByWorkerIdText = string.Empty;
    private string _assignedInvestigatorIdText = string.Empty;
    private DateTime? _occurredAtUtc = DateTime.UtcNow;
    private bool _isSubmitting;
    private string? _createError;

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "New Incident",
            activeModuleCode: "incident-management",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Incident Management", Href = RouteDefinitions.IncidentManagementList },
                new BreadcrumbItem { Label = "New" }
            ]);

        if (TenantCtx.Tenant?.SiteId is { } siteId)
            _siteIdText = siteId.ToString();
    }

    private async Task SubmitAsync()
    {
        _createError = null;

        if (!Guid.TryParse(_siteIdText, out var siteIdValue))
        {
            _createError = "Site Id must be a valid GUID.";
            return;
        }

        if (!Guid.TryParse(_reportedByWorkerIdText, out var reportedByWorkerId))
        {
            _createError = "Reported By Worker Id must be a valid GUID.";
            return;
        }

        Guid? assignedInvestigatorId = null;
        if (!string.IsNullOrWhiteSpace(_assignedInvestigatorIdText))
        {
            if (!Guid.TryParse(_assignedInvestigatorIdText, out var parsedInvestigatorId))
            {
                _createError = "Assigned Investigator Id must be a valid GUID when provided.";
                return;
            }
            assignedInvestigatorId = parsedInvestigatorId;
        }

        _model.SiteId = siteIdValue;
        _model.ReportedByWorkerId = reportedByWorkerId;
        _model.AssignedInvestigatorId = assignedInvestigatorId;
        _model.IncidentOccurredAtUtc = _occurredAtUtc.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(_occurredAtUtc.Value, DateTimeKind.Utc))
            : DateTimeOffset.UtcNow;

        _isSubmitting = true;
        var envelope = await ApiClient.CreateIncidentAsync(_model);
        _isSubmitting = false;

        if (envelope.IsSuccess)
        {
            Nav.NavigateTo($"{RouteDefinitions.IncidentManagementList}/{envelope.Data}");
        }
        else if (envelope.IsProblem)
        {
            _createError = envelope.Problem!.Detail;
        }
        else
        {
            _createError = $"Failed to create incident: {envelope.FaultType}";
        }
    }

    private void NavigateToList() => Nav.NavigateTo(RouteDefinitions.IncidentManagementList);

    public void Dispose() { }
}

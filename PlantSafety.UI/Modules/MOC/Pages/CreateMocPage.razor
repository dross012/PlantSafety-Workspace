@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-08-05
   FILE DESCRIPTION: Create MOC (initiate Management of Change request) form.
     Submits a CreateMocRequest via POST v1/features/compliance/management-of-change
     (MocApiClient.CreateMocAsync, backed by the real CreateMocCommand). Only
     the fields the real command accepts are surfaced: SiteId, Title,
     Description, ChangeType, RiskLevel, InitiatorId, ProposedStartUtc,
     ProposedEndUtc. This Create endpoint lives in a different bounded
     context (Features/Compliance/ManagementOfChange) than the
     MOCWorkflows/Approvals/RiskAssessments read models the MOC list/detail
     pages display, and there is no GetById linking the two — on success
     this page returns to the MOC list rather than a specific detail record.
     No Update/Delete command exists for MOC requests anywhere in the
     Application layer, so no Edit/Delete actions are offered. Follows the
     canonical Blazor UI form pattern established in
     Modules/Financials/Pages/CreateBudgetPage.razor.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/moc/new"

@inject MocState State
@inject MocApiClient ApiClient
@inject TenantState TenantCtx
@inject UserSessionState UserSession
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.MOC.ApiClients
@using PlantSafety.UI.Modules.MOC.Models
@using PlantSafety.UI.Modules.MOC.State

<PageTitle>New MOC Request — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Create MOC form could not be displayed.">

        <div class="ps-detail-header">
            <h2 class="ps-detail-title">New Management of Change Request</h2>
        </div>

        @if (State.CreateMocError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.CreateMocError</div>
        }

        <div class="ps-form-card">
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="ps-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="ps-form-error" />

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="title">Title</label>
                        <InputText id="title" @bind-Value="_model.Title" maxlength="200" />
                        <ValidationMessage For="() => _model.Title" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="change-type">Change Type</label>
                        <InputSelect id="change-type" @bind-Value="_model.ChangeType">
                            <option value="Permanent">Permanent</option>
                            <option value="Temporary">Temporary</option>
                            <option value="Emergency">Emergency</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="description">Description</label>
                        <InputTextArea id="description" @bind-Value="_model.Description" maxlength="4000" />
                        <ValidationMessage For="() => _model.Description" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="risk-level">Risk Level</label>
                        <InputSelect id="risk-level" @bind-Value="_model.RiskLevel">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </InputSelect>
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="site-id">Site Id</label>
                        <InputText id="site-id" @bind-Value="_siteIdText" placeholder="GUID" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="initiator-id">Initiator Id</label>
                        <InputText id="initiator-id" @bind-Value="_initiatorIdText" placeholder="GUID" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="proposed-start">Proposed Start</label>
                        <InputDate id="proposed-start" Type="InputDateType.DateTimeLocal" @bind-Value="_proposedStartLocal" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="proposed-end">Proposed End (optional)</label>
                        <InputDate id="proposed-end" Type="InputDateType.DateTimeLocal" @bind-Value="_proposedEndLocal" />
                    </div>
                </div>

                <div class="ps-form-actions">
                    <button type="submit" class="ps-btn ps-btn-primary" disabled="@State.IsCreatingMoc">
                        @if (State.IsCreatingMoc)
                        {
                            <span class="bi bi-arrow-repeat" aria-hidden="true"></span> <text>Submitting…</text>
                        }
                        else
                        {
                            <span class="bi bi-check-circle" aria-hidden="true"></span> <text>Submit MOC Request</text>
                        }
                    </button>
                    <button type="button" class="ps-btn ps-btn-ghost" @onclick="NavigateToList" disabled="@State.IsCreatingMoc">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>

    </ErrorBoundaryComponent>

</div>

@code {
    private readonly CreateMocRequest _model = new();
    private string _siteIdText = string.Empty;
    private string _initiatorIdText = string.Empty;
    private DateTime? _proposedStartLocal = DateTime.Now;
    private DateTime? _proposedEndLocal;

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "New MOC Request",
            activeModuleCode: "moc",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "MOC", Href = RouteDefinitions.MocList },
                new BreadcrumbItem { Label = "New" }
            ]);

        State.ResetCreateMoc();

        var siteId = TenantCtx.Tenant?.SiteId;
        if (siteId is not null)
            _siteIdText = siteId.Value.ToString();

        State.OnChange += StateHasChanged;
    }

    private async Task SubmitAsync()
    {
        if (!Guid.TryParse(_siteIdText, out var siteId))
        {
            State.SetCreateMocError("Site Id must be a valid GUID.");
            return;
        }

        if (!Guid.TryParse(_initiatorIdText, out var initiatorId))
        {
            State.SetCreateMocError("Initiator Id must be a valid GUID.");
            return;
        }

        if (_proposedStartLocal is null)
        {
            State.SetCreateMocError("Proposed start date is required.");
            return;
        }

        _model.SiteId = siteId;
        _model.InitiatorId = initiatorId;
        _model.ProposedStartUtc = new DateTimeOffset(DateTime.SpecifyKind(_proposedStartLocal.Value, DateTimeKind.Utc));
        _model.ProposedEndUtc = _proposedEndLocal is not null
            ? new DateTimeOffset(DateTime.SpecifyKind(_proposedEndLocal.Value, DateTimeKind.Utc))
            : null;

        State.BeginCreateMoc();

        var envelope = await ApiClient.CreateMocAsync(_model);

        if (envelope.IsSuccess)
        {
            State.SetCreateMocSuccess(envelope.Data!);
            Nav.NavigateTo(RouteDefinitions.MocList);
        }
        else if (envelope.IsProblem)
        {
            State.SetCreateMocError(envelope.Problem!.Detail);
        }
        else
        {
            State.SetCreateMocError($"Failed to submit MOC request: {envelope.FaultType}");
        }
    }

    private void NavigateToList() => Nav.NavigateTo(RouteDefinitions.MocList);

    public void Dispose() => State.OnChange -= StateHasChanged;
}

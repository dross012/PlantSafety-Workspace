   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   UPDATED: 2026-08-05 — Added a Print action (window.print via JS interop);
     removed the stale "needs backend wiring" notice now that GetById is
     live. No field-level Update/Delete command exists for this aggregate —
     Drills supports Create (schedule) only, so no Edit/Delete actions are
     offered here.
   FILE DESCRIPTION: Drill detail/drilldown page. Calls the real GetById
     endpoint at /v1/features/safety-events/drills/{id}; falls back to the
     standard error state via ErrorBoundaryComponent on Problem/Fault
     responses.
   SchemaVersion: 2026.2
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/drills/{DrillId:guid}"

@inject DrillsState State
@inject DrillsApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav
@inject IJSRuntime JS

@implements IDisposable

@using PlantSafety.UI.Modules.Drills.State
@using PlantSafety.UI.Modules.Drills.ApiClients
@using PlantSafety.UI.Modules.Drills.Mappings

<PageTitle>Drill Detail — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The drill detail could not be displayed.">

        @if (State.IsLoadingDetail)
        {
            <LoadingIndicatorComponent Message="Loading drill…" />
        }
        else if (State.DetailError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.DetailError</div>
        }
        else if (State.Selected is { } item)
        {
            var vm = item.ToViewModel();
            <div class="ps-detail-card">
                <div class="ps-detail-header">
                    <h2 class="ps-detail-title">@item.Title</h2>
                    <StatusIndicatorComponent Status="@vm.OperationalStatus" Label="@item.Status" />
                </div>

                <CardComponent Title="Summary">
                    <dl class="ps-detail-fields">
                        <dt>Description</dt>   <dd>@item.Description</dd>
                        <dt>Drill Type</dt>    <dd>@item.DrillType</dd>
                        <dt>Site</dt>          <dd class="ps-mono">@item.SiteId</dd>
                        <dt>Coordinator</dt>   <dd class="ps-mono">@item.CoordinatorId</dd>
                        <dt>Scheduled</dt>     <dd>@item.ScheduledAtUtc.ToString("u") UTC</dd>
                        @if (item.ExecutedAtUtc is not null)
                        {
                            <dt>Executed</dt> <dd>@item.ExecutedAtUtc?.ToString("u") UTC</dd>
                        }
                        <dt>Outcome Score</dt> <dd>@(item.OutcomeScore?.ToString() ?? "Not yet evaluated")</dd>
                        <dt>Record ID</dt>     <dd class="ps-mono">@item.DrillId</dd>
                    </dl>
                </CardComponent>

                <div class="ps-detail-actions">
                    <button class="ps-btn ps-btn-ghost" @onclick="() => Nav.NavigateTo(RouteDefinitions.DrillsList)">
                        <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to Drills &amp; Exercises
                    </button>
                    <button class="ps-btn ps-btn-ghost" @onclick="PrintAsync">
                        <span class="bi bi-printer" aria-hidden="true"></span> Print
                    </button>
                </div>
            </div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    [Parameter] public Guid DrillId { get; set; }

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Drill Detail",
            activeModuleCode: "drills",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Drills & Exercises", Href = RouteDefinitions.DrillsList },
                new BreadcrumbItem { Label = "Detail" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        State.BeginDetailLoad();
        var envelope = await ApiClient.GetDrillAsync(DrillId);

        if (envelope.IsSuccess)
            State.SetSelected(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetDetailError(envelope.Problem!.Detail);
        else
            State.SetDetailError($"Failed to load drill: {envelope.FaultType}");
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    public void Dispose() => State.OnChange -= StateHasChanged;
}

@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   UPDATED: 2026-08-05 — Added a Status/Drill Type filter bar (bound to the
     real ListDrillsQuery Status/DrillType parameters) and a "New Drill"
     action linking to CreateDrillPage. Removed the stale "needs backend
     wiring" notice — the List/GetById endpoints have existed since this
     module's DrillsV1Controller was introduced.
   FILE DESCRIPTION: Drills & Exercises list page. Calls the real paginated
     List endpoint at /v1/features/safety-events/drills.
   SchemaVersion: 2026.2
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/drills"

@inject DrillsState State
@inject DrillsApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.Drills.State
@using PlantSafety.UI.Modules.Drills.ApiClients
@using PlantSafety.UI.Modules.Drills.Mappings
@using PlantSafety.UI.Modules.Drills.Models

<PageTitle>Drills &amp; Exercises — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Drills list could not be displayed." OnRetry="LoadPageAsync">

        <div class="ps-page-actions">
            <a href="@RouteDefinitions.DrillsCreate" class="ps-btn ps-btn-primary ps-btn-sm">
                <span class="bi bi-plus-circle" aria-hidden="true"></span> New Drill
            </a>
            <label class="ps-field-label" for="drill-status-filter">Status</label>
            <select id="drill-status-filter" class="ps-btn ps-btn-ghost ps-btn-sm" @onchange="OnStatusChangedAsync">
                <option value="">All</option>
                <option value="Scheduled">Scheduled</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
            <label class="ps-field-label" for="drill-type-filter">Type</label>
            <select id="drill-type-filter" class="ps-btn ps-btn-ghost ps-btn-sm" @onchange="OnDrillTypeChangedAsync">
                <option value="">All</option>
                <option value="EvacuationDrill">EvacuationDrill</option>
                <option value="FireDrill">FireDrill</option>
                <option value="MedicalEmergency">MedicalEmergency</option>
                <option value="HazMatResponse">HazMatResponse</option>
                <option value="ActiveThreat">ActiveThreat</option>
                <option value="TableTop">TableTop</option>
                <option value="FullScale">FullScale</option>
            </select>
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadPageAsync" disabled="@State.IsLoadingList">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.ListError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.ListError</div>
        }

        @if (State.IsLoadingList)
        {
            <LoadingIndicatorComponent Message="Loading drills…" />
        }
        else if (State.ListError is null)
        {
            <DataGridComponent TItem="DrillDto"
                                Items="State.Items"
                                Headers="_headers"
                                KeySelector="d => d.DrillId"
                                EmptyMessage="No drills scheduled."
                                AriaLabel="Drills and exercises">
                <RowTemplate Context="item">
                    @{ var vm = item.ToViewModel(); }
                    <td>@item.DrillType</td>
                    <td>@item.Title</td>
                    <td><StatusIndicatorComponent Status="@vm.OperationalStatus" Label="@item.Status" /></td>
                    <td>@item.ScheduledAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>@(item.OutcomeScore?.ToString() ?? "—")</td>
                    <td>
                        <a href="@RouteDefinitions.DrillsList/@item.DrillId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                    </td>
                </RowTemplate>
            </DataGridComponent>

            @if (State.TotalPages > 1)
            {
                <PaginationComponent CurrentPage="State.CurrentPage"
                                      TotalPages="State.TotalPages"
                                      TotalCount="State.TotalCount"
                                      PageChanged="GoToPageAsync" />
            }
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Type", "Title", "Status", "Scheduled", "Outcome", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Drills & Exercises",
            activeModuleCode: "drills",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Drills & Exercises" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadPageAsync();
    }

    private async Task LoadPageAsync() => await GoToPageAsync(1);

    private async Task GoToPageAsync(int page)
    {
        State.BeginListLoad();
        var envelope = await ApiClient.ListDrillsAsync(
            pageNumber: page,
            pageSize: 25,
            status: State.StatusFilter,
            drillType: State.DrillTypeFilter);

        if (envelope.IsSuccess)
            State.SetItems(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetListError(envelope.Problem!.Detail);
        else
            State.SetListError($"Failed to load drills: {envelope.FaultType}");
    }

    private async Task OnStatusChangedAsync(ChangeEventArgs e)
    {
        State.SetStatusFilter(e.Value?.ToString());
        await GoToPageAsync(1);
    }

    private async Task OnDrillTypeChangedAsync(ChangeEventArgs e)
    {
        State.SetDrillTypeFilter(e.Value?.ToString());
        await GoToPageAsync(1);
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

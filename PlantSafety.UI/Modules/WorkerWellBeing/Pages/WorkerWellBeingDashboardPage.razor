@page "/modules/worker-wellbeing"

@inject WorkerWellBeingState State
@inject WorkerWellBeingApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.WorkerWellBeing.State
@using PlantSafety.UI.Modules.WorkerWellBeing.ApiClients
@using PlantSafety.UI.Modules.WorkerWellBeing.Mappings
@using PlantSafety.UI.Modules.WorkerWellBeing.Models

<PageTitle>Worker WellBeing — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Worker WellBeing dashboard could not be displayed." OnRetry="LoadAsync">

        <div class="ps-page-actions">
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadAsync" disabled="@State.IsLoadingList">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.ListError is not null)
        {
            <div class="ps-alert ps-alert--warning" role="alert">
                @State.ListError
            </div>
        }

        @if (State.IsLoadingList)
        {
            <LoadingIndicatorComponent Message="Loading Worker WellBeing records…" />
        }
        else if (State.ListError is null)
        {
            <DataGridComponent TItem="WorkerWellBeingDto"
                                Items="State.Items"
                                Headers="_headers"
                                KeySelector="w => w.WorkerWellBeingId"
                                EmptyMessage="No Worker WellBeing records found."
                                AriaLabel="Worker WellBeing records">
                <RowTemplate Context="item">
                    @{ var vm = item.ToViewModel(); }
                    <td><SeverityBadgeComponent Severity="@vm.SeverityForBadge" Text="@item.WellBeingRiskLevel" /></td>
                    <td class="ps-mono">@item.WorkerId</td>
                    <td><StatusIndicatorComponent Status="@vm.OperationalStatus" Label="@item.Status" /></td>
                    <td>@item.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a href="@RouteDefinitions.WorkerWellBeingDashboard/@item.WorkerWellBeingId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                    </td>
                </RowTemplate>
            </DataGridComponent>

            @if (State.TotalPages > 1)
            {
                <PaginationComponent CurrentPage="State.CurrentPage"
                                      TotalPages="State.TotalPages"
                                      TotalCount="State.TotalCount"
                                      PageChanged="GoToPageAsync" />
            }
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Risk Level", "Worker", "Status", "Recorded", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Worker WellBeing",
            activeModuleCode: "worker-wellbeing",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Worker WellBeing" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync() => await GoToPageAsync(1);

    private async Task GoToPageAsync(int page)
    {
        State.BeginListLoad();
        var envelope = await ApiClient.ListWorkerWellBeingRecordsAsync(pageNumber: page, pageSize: 25);

        if (envelope.IsSuccess)
            State.SetItems(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetListError(envelope.Problem!.Detail);
        else
            State.SetListError($"Failed to load Worker WellBeing records: {envelope.FaultType}");
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Enterprise Fabric dashboard/list page. No PlantSafety.Api
     read-model endpoint exists yet for fabric topology (PlantSafety.Domain
     /EnterpriseFabric is a thin scaffold aggregate; the only wired Api
     surface is an unrelated write-only Users command) — this page is built
     against the best-inferable DTO shape (EnterpriseFabricModels.cs) and
     degrades gracefully to a "needs backend wiring" Error/Empty state rather
     than blocking. Built entirely from the canonical Shared component
     library.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/enterprise-fabric"

@inject EnterpriseFabricState State
@inject EnterpriseFabricApiClient ApiClient
@inject UserSessionState UserSession
@inject TenantState TenantCtx
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.EnterpriseFabric.ApiClients
@using PlantSafety.UI.Modules.EnterpriseFabric.Models

<PageTitle>Enterprise Fabric — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Enterprise Fabric dashboard could not be displayed." OnRetry="LoadAsync">

        <div class="ps-page-actions">
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadAsync" disabled="@State.IsLoading">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.LoadError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.LoadError</div>
            <p class="ps-needs-backend">
                <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                Enterprise Fabric needs backend wiring — no PlantSafety.Api read-model endpoint exists yet
                for GET v1/enterprise-fabric/nodes.
            </p>
        }

        @if (State.IsLoading)
        {
            <LoadingIndicatorComponent Message="Loading fabric node registry…" />
        }
        else if (State.LoadError is null)
        {
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:var(--ps-space-4);">
                <CardComponent Title="Total Nodes"><span class="ps-field-value">@State.Nodes.Count</span></CardComponent>
                <CardComponent Title="Connected"><span class="ps-field-value">@CountByStatus("connected")</span></CardComponent>
                <CardComponent Title="Degraded"><span class="ps-field-value">@CountByStatus("degraded")</span></CardComponent>
                <CardComponent Title="Offline"><span class="ps-field-value">@CountByStatus("offline")</span></CardComponent>
            </div>

            <DataGridComponent TItem="FabricNodeDto"
                                Items="State.Nodes"
                                Headers="_headers"
                                KeySelector="n => n.NodeId"
                                EmptyMessage="No fabric nodes registered for this tenant."
                                AriaLabel="Enterprise Fabric Nodes">
                <RowTemplate Context="node">
                    <td><StatusIndicatorComponent Status="@MapStatus(node.Status)" Label="@node.Status" /></td>
                    <td>@node.NodeName</td>
                    <td><span class="ps-chip">@node.NodeType</span></td>
                    <td>@node.Region</td>
                    <td>@node.LastHeartbeatAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a href="/modules/enterprise-fabric/@node.NodeId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                    </td>
                </RowTemplate>
            </DataGridComponent>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Status", "Node", "Type", "Region", "Last Heartbeat", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Enterprise Fabric",
            activeModuleCode: "enterprise-fabric",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Enterprise Fabric" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        State.BeginLoad();

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var envelope = await ApiClient.GetFabricNodesAsync(tenantId, siteId: null);

        if (envelope.IsSuccess)
            State.SetNodes(envelope.Data!.Items);
        else if (envelope.IsProblem)
            State.SetLoadError(envelope.Problem!.Detail);
        else
            State.SetLoadError($"Enterprise Fabric service is not yet available: {envelope.FaultType}");
    }

    private int CountByStatus(string status) =>
        State.Nodes.Count(n => string.Equals(n.Status, status, StringComparison.OrdinalIgnoreCase));

    private static string MapStatus(string status) => status.ToLowerInvariant() switch
    {
        "connected" => "Healthy",
        "degraded" => "Warning",
        "offline" => "Critical",
        _ => "Offline",
    };

    public void Dispose() => State.OnChange -= StateHasChanged;
}

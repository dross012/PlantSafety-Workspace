@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: JSA detail page. The read-model API exposes only a list
     endpoint (GET api/v1/operational/job-safety-analysis, no GetById) — the
     record is resolved from the already-loaded JsaState.AllItems when
     navigated to from the list, or by re-querying a wide date window when
     deep-linked directly. Tabbed step-by-step checklist workspace (hazard
     list / control measures / sign-off, per compliance/checklist-heavy
     module guidance) built entirely from the canonical Shared component
     library: ErrorBoundaryComponent, LoadingIndicatorComponent,
     TabControlComponent, CardComponent, SeverityBadgeComponent,
     StatusIndicatorComponent.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/jsa/{JobSafetyAnalysisId:guid}"

@inject JsaState State
@inject JsaApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav
@inject TenantState TenantCtx
@inject UserSessionState UserSession

@implements IDisposable

@using PlantSafety.UI.Modules.Jsa.ApiClients
@using PlantSafety.UI.Modules.Jsa.Models
@using PlantSafety.UI.Modules.Jsa.Services
@using PlantSafety.UI.Modules.Jsa.State

<PageTitle>JSA Detail — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The JSA detail could not be displayed.">

        @if (State.IsLoadingDetail)
        {
            <LoadingIndicatorComponent Message="Loading JSA record…" />
        }
        else if (State.DetailError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.DetailError</div>
        }
        else if (State.SelectedItem is { } record)
        {
            <div class="ps-detail-header">
                <h2 class="ps-detail-title">@record.TaskName</h2>
                <SeverityBadgeComponent Severity="@JsaUiService.NormalizeSeverity(record.RiskLevel)" />
                <StatusIndicatorComponent Status="@JsaUiService.MapStatusToOperationalState(record.Status)" Label="@record.Status" />
            </div>

            <TabControlComponent Tabs="_tabLabels" ActiveIndex="_activeTab" ActiveIndexChanged="OnTabChanged" AriaLabel="JSA record sections" />

            <div class="ps-tab-panel" role="tabpanel">

                @if (_activeTab == 0)
                {
                    <CardComponent Title="Overview">
                        <div class="ps-field-row"><span class="ps-field-label">Task</span><span class="ps-field-value">@record.TaskName</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Risk Level</span><span><SeverityBadgeComponent Severity="@JsaUiService.NormalizeSeverity(record.RiskLevel)" /></span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Status</span><span><StatusIndicatorComponent Status="@JsaUiService.MapStatusToOperationalState(record.Status)" Label="@record.Status" /></span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Analyzed</span><span class="ps-field-value">@record.AnalyzedAtUtc.ToString("u") UTC</span></div>
                    </CardComponent>
                }

                @if (_activeTab == 1)
                {
                    <CardComponent Title="Record Detail">
                        <div class="ps-field-row"><span class="ps-field-label">Record ID</span><span class="ps-field-value ps-mono">@record.JobSafetyAnalysisId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Tenant ID</span><span class="ps-field-value ps-mono">@record.TenantId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Site ID</span><span class="ps-field-value ps-mono">@(record.SiteId?.ToString() ?? "All sites")</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Analyzed By</span><span class="ps-field-value ps-mono">@record.AnalyzedBy</span></div>
                    </CardComponent>
                }

                @if (_activeTab == 2)
                {
                    <CardComponent Title="Job Steps &amp; Hazards">
                        <p class="ps-field-value">A step-by-step task breakdown (each job step paired with its
                            identified hazards) will render here per module.</p>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            Job step and hazard breakdown needs backend wiring — the JSA read-model endpoint
                            returns only the summary risk level and task name shown in Overview today.
                        </p>
                    </CardComponent>
                }

                @if (_activeTab == 3)
                {
                    <CardComponent Title="Control Measures">
                        <p class="ps-field-value">Per-hazard control measures (engineering/administrative/PPE, mapped
                            to the hierarchy of controls) will render here per module.</p>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            Control-measure tracking needs backend wiring — no data source exists yet for
                            per-hazard control measures on this record.
                        </p>
                    </CardComponent>
                }

                @if (_activeTab == 4)
                {
                    <CardComponent Title="Sign-off &amp; Approval">
                        <button class="ps-btn ps-btn-ghost ps-btn-sm" @onclick="() => Nav.NavigateTo(RouteDefinitions.JsaList)">
                            <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to JSA
                        </button>
                        <button class="ps-btn ps-btn-primary ps-btn-sm" disabled aria-label="Approve JSA">
                            <span class="bi bi-check2-circle" aria-hidden="true"></span> Approve
                        </button>
                        <button class="ps-btn ps-btn-primary ps-btn-sm" disabled aria-label="Request crew acknowledgement">
                            <span class="bi bi-people" aria-hidden="true"></span> Request Crew Acknowledgement
                        </button>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            Approval and crew sign-off/acknowledgement need backend wiring — no command
                            endpoint exists yet for the JSA module (read-only today).
                        </p>
                    </CardComponent>
                }

            </div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _tabLabels = ["Overview", "Record Detail", "Job Steps & Hazards", "Control Measures", "Sign-off & Approval"];
    private int _activeTab;

    [Parameter] public Guid JobSafetyAnalysisId { get; set; }

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "JSA Detail",
            activeModuleCode: "jsa",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "JSA", Href = RouteDefinitions.JsaList },
                new BreadcrumbItem { Label = "Detail" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ResolveRecordAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (State.SelectedItem is { } current && current.JobSafetyAnalysisId == JobSafetyAnalysisId)
            return;

        await ResolveRecordAsync();
    }

    private async Task ResolveRecordAsync()
    {
        State.BeginDetailLoad();

        var existing = State.AllItems.FirstOrDefault(i => i.JobSafetyAnalysisId == JobSafetyAnalysisId);
        if (existing is not null)
        {
            State.SetSelectedItem(existing);
            return;
        }

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var fromUtc = DateTime.UtcNow.AddYears(-2);
        var toUtc = DateTime.UtcNow;

        var envelope = await ApiClient.GetJobSafetyAnalysisAsync(tenantId, siteId: null, fromUtc, toUtc);

        if (envelope.IsSuccess)
        {
            var found = envelope.Data!.Items.FirstOrDefault(i => i.JobSafetyAnalysisId == JobSafetyAnalysisId);
            if (found is not null)
                State.SetSelectedItem(found);
            else
                State.SetDetailError("This JSA record could not be found.");
        }
        else if (envelope.IsProblem)
        {
            State.SetDetailError(string.IsNullOrWhiteSpace(envelope.Problem!.Detail) ? "The request failed." : envelope.Problem!.Detail);
        }
        else
        {
            State.SetDetailError($"Failed to load JSA record: {envelope.FaultType}");
        }
    }

    private Task OnTabChanged(int index)
    {
        _activeTab = index;
        return Task.CompletedTask;
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

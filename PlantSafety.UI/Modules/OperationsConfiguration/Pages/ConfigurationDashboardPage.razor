@*  ============================================================
    AUTHOR: PlantSafety Platform
    CREATED: 2026-07-20
    FILE DESCRIPTION: Operations Configuration Framework dashboard. Surfaces the real
      Phase 14 Governance [System].[FeatureFlag] tables (144-feature-flags.sql), confirmed
      present ONLY in PlantSafety.ArchiveDB and PlantSafety.IntegrationDB.

      SCOPE NOTE: The roadmap deliverable for this module was "a configuration editor:
      feature flags, thresholds, routing rules, tenant overrides." A full search of
      PlantSafety.Infrastructure\Persistence\Migrations\**\*.sql for tables named
      Threshold/RoutingRule/TenantOverride/TenantConfig (or similar) found NO backing SQL
      Server tables for thresholds, routing rules, or tenant overrides as of this build
      (2026-07-20) — only unrelated EnvironmentalHealth.Threshold *columns* exist, which
      are ordinary domain data, not a configuration-editor target. Per the No-Guessing
      Rule for Schema Generation, this page deliberately does NOT fabricate editors for
      those three areas; it is scoped honestly to feature-flag management only, with the
      note below left in place until real tables are built.
    SchemaVersion: 2026.1
    Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
    ============================================================ *@

@page "/modules/operations-configuration"

@inject ConfigurationState State
@inject ConfigurationApiClient ApiClient
@inject NavigationState NavState

@implements IDisposable

@using PlantSafety.UI.Modules.OperationsConfiguration.ApiClients
@using PlantSafety.UI.Modules.OperationsConfiguration.Models
@using PlantSafety.UI.Modules.OperationsConfiguration.State

<PageTitle>Operations — Configuration — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Configuration dashboard could not be displayed." OnRetry="LoadDashboardAsync">

        <div class="ps-page-actions">
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadDashboardAsync" disabled="@State.IsLoading">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.Error is not null)
        {
            <div class="ps-alert ps-alert--warning" role="alert">@State.Error</div>
        }

        @if (State.ToggleMessage is not null)
        {
            <div class="ps-alert ps-alert--info" role="status">@State.ToggleMessage</div>
        }

        @if (State.IsLoading)
        {
            <LoadingIndicatorComponent Message="Loading feature flags…" />
        }
        else
        {
            <section class="ps-section">
                <h2>Feature Flags</h2>
                <p class="ps-text-muted">
                    DB-level ops kill-switches from <code>[System].[FeatureFlag]</code>, checked
                    directly by SQL Server-side jobs/procedures (independent of the API process
                    being up). Toggling a flag here is a normal, reversible update — every change
                    is recorded with your identity and timestamp in the flag's UpdatedBy/UpdatedUtc
                    columns.
                </p>
                <DataGridComponent TItem="FeatureFlagDto"
                                    Items="State.Flags"
                                    Headers="_flagHeaders"
                                    KeySelector="f => ConfigurationState.FlagKey(f.DatabaseKey, f.FlagName)"
                                    EmptyMessage="No feature flags found."
                                    AriaLabel="Feature flags">
                    <RowTemplate Context="item">
                        <td>@item.DatabaseKey</td>
                        <td>@item.FlagName</td>
                        <td>
                            <StatusIndicatorComponent Status="@(item.IsEnabled ? "Healthy" : "Offline")" Label="@(item.IsEnabled ? "Enabled" : "Disabled")" />
                        </td>
                        <td>@item.Description</td>
                        <td>@item.UpdatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td>@item.UpdatedBy</td>
                        <td>
                            <button class="ps-btn ps-btn-ghost ps-btn-sm"
                                    @onclick="() => ToggleFlagAsync(item)"
                                    disabled="@(State.TogglingFlagKey == ConfigurationState.FlagKey(item.DatabaseKey, item.FlagName))">
                                @(State.TogglingFlagKey == ConfigurationState.FlagKey(item.DatabaseKey, item.FlagName)
                                    ? "Updating…"
                                    : (item.IsEnabled ? "Disable" : "Enable"))
                            </button>
                        </td>
                    </RowTemplate>
                </DataGridComponent>
            </section>

            <section class="ps-section">
                <h2>Thresholds / Routing Rules</h2>
                <div class="ps-alert ps-alert--warning" role="note">
                    <span class="bi bi-exclamation-triangle" aria-hidden="true"></span>
                    Out of scope for this build. No SQL Server tables for Thresholds or Routing
                    Rules exist in the codebase as of 2026-07-20 (confirmed by searching every
                    migration script under <code>PlantSafety.Infrastructure\Persistence\Migrations</code>).
                    This page will not fabricate editors for data that does not exist — these
                    sections will be added once real backing tables are built.
                </div>
            </section>

            <section class="ps-section">
                <h2>Tenant / User / Region Overrides &amp; Release Management</h2>
                <p class="ps-text-muted">
                    Phase 7 §7.1/§7.2: real tenant/user/region feature-flag overrides, resolution,
                    tenant release channels, and rollback automation, backed by
                    <code>200-tenant-user-region-feature-flag-overrides.sql</code>. Resolution
                    precedence is <strong>user &gt; tenant &gt; region &gt; global</strong>.
                </p>

                @if (State.OverridesMessage is not null)
                {
                    <div class="ps-alert ps-alert--info" role="status">@State.OverridesMessage</div>
                }

                <CardComponent Title="Set Feature Flag Rollout Percentage">
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="rollout-db">Database</label>
                        <input id="rollout-db" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_rolloutDatabaseKey" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="rollout-flag">Flag Name</label>
                        <input id="rollout-flag" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_rolloutFlagName" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="rollout-pct">Rollout % (blank = clear)</label>
                        <input id="rollout-pct" type="number" min="0" max="100" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_rolloutPercentage" />
                    </div>
                    <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="SetRolloutPercentageAsync" disabled="@State.IsSubmittingOverride">Apply</button>
                </CardComponent>

                <CardComponent Title="Tenant-Level Override">
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="tenant-ovr-flag">Flag Name</label>
                        <input id="tenant-ovr-flag" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_tenantOverrideFlagName" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="tenant-ovr-id">Tenant Id</label>
                        <input id="tenant-ovr-id" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_tenantOverrideTenantId" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="tenant-ovr-enabled">Enabled</label>
                        <input id="tenant-ovr-enabled" type="checkbox" @bind="_tenantOverrideEnabled" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="tenant-ovr-pct">Rollout % (blank = none)</label>
                        <input id="tenant-ovr-pct" type="number" min="0" max="100" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_tenantOverrideRolloutPercentage" />
                    </div>
                    <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="SetTenantOverrideAsync" disabled="@State.IsSubmittingOverride">Apply</button>
                </CardComponent>

                <CardComponent Title="User-Level Override">
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="user-ovr-flag">Flag Name</label>
                        <input id="user-ovr-flag" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_userOverrideFlagName" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="user-ovr-id">User Id</label>
                        <input id="user-ovr-id" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_userOverrideUserId" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="user-ovr-enabled">Enabled</label>
                        <input id="user-ovr-enabled" type="checkbox" @bind="_userOverrideEnabled" />
                    </div>
                    <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="SetUserOverrideAsync" disabled="@State.IsSubmittingOverride">Apply</button>
                </CardComponent>

                <CardComponent Title="Region-Level Override">
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="region-ovr-flag">Flag Name</label>
                        <input id="region-ovr-flag" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_regionOverrideFlagName" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="region-ovr-region">Region</label>
                        <input id="region-ovr-region" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_regionOverrideRegion" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="region-ovr-enabled">Enabled</label>
                        <input id="region-ovr-enabled" type="checkbox" @bind="_regionOverrideEnabled" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="region-ovr-pct">Rollout % (blank = none)</label>
                        <input id="region-ovr-pct" type="number" min="0" max="100" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_regionOverrideRolloutPercentage" />
                    </div>
                    <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="SetRegionOverrideAsync" disabled="@State.IsSubmittingOverride">Apply</button>
                </CardComponent>

                <CardComponent Title="Tenant Release Channel">
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="channel-tenant-id">Tenant Id</label>
                        <input id="channel-tenant-id" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_channelTenantId" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="channel-value">Channel</label>
                        <select id="channel-value" class="ps-btn ps-btn-ghost ps-btn-sm" @bind="_channelValue">
                            <option value="Stable">Stable</option>
                            <option value="Beta">Beta</option>
                            <option value="Canary">Canary</option>
                        </select>
                    </div>
                    <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="SetReleaseChannelAsync" disabled="@State.IsSubmittingOverride">Apply</button>
                </CardComponent>

                <CardComponent Title="Trigger Rollback" CssClass="ps-card--danger">
                    <p class="ps-text-muted">
                        Reverts the global flag's rollout percentage (and every tenant/region
                        override's rollout percentage) to 0. Use when a canary rollout must be
                        reversed immediately.
                    </p>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="rollback-db">Database</label>
                        <input id="rollback-db" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_rollbackDatabaseKey" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="rollback-flag">Flag Name</label>
                        <input id="rollback-flag" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_rollbackFlagName" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="rollback-reason">Reason</label>
                        <input id="rollback-reason" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_rollbackReason" />
                    </div>
                    <div class="ps-field-row">
                        <label class="ps-field-label" for="rollback-hard-disable">Hard-disable global flag</label>
                        <input id="rollback-hard-disable" type="checkbox" @bind="_rollbackHardDisable" />
                    </div>
                    <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="TriggerRollbackAsync" disabled="@State.IsSubmittingOverride">Trigger Rollback</button>
                </CardComponent>
            </section>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _flagHeaders = ["Database", "Flag", "Status", "Description", "Last Updated", "Updated By", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Configuration",
            activeModuleCode: "operations-configuration",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Configuration" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        State.BeginLoad();

        var result = await ApiClient.GetAllFeatureFlagsAsync();

        if (result.IsSuccess)
        {
            State.SetData(result.Data!);
        }
        else
        {
            State.SetError(result.IsProblem ? result.Problem!.Detail : $"Failed to load feature flags: {result.FaultType}");
        }
    }

    private async Task ToggleFlagAsync(FeatureFlagDto item)
    {
        State.BeginToggle(item.DatabaseKey, item.FlagName);

        var result = await ApiClient.SetFeatureFlagEnabledAsync(item.DatabaseKey, item.FlagName, !item.IsEnabled);

        if (result.IsSuccess)
        {
            State.ApplyToggleResult(result.Data!);
        }
        else
        {
            State.SetToggleError(result.IsProblem ? $"Failed to update {item.FlagName}: {result.Problem!.Detail}" : $"Failed to update {item.FlagName}: {result.FaultType}");
        }
    }

    // ── Phase 7 §7.1/§7.2 Tenant/User/Region overrides + release channel + rollback ──

    private string _rolloutDatabaseKey = "ArchiveDB";
    private string _rolloutFlagName = string.Empty;
    private int? _rolloutPercentage;

    private string _tenantOverrideFlagName = string.Empty;
    private string _tenantOverrideTenantId = string.Empty;
    private bool _tenantOverrideEnabled = true;
    private int? _tenantOverrideRolloutPercentage;

    private string _userOverrideFlagName = string.Empty;
    private string _userOverrideUserId = string.Empty;
    private bool _userOverrideEnabled = true;

    private string _regionOverrideFlagName = string.Empty;
    private string _regionOverrideRegion = string.Empty;
    private bool _regionOverrideEnabled = true;
    private int? _regionOverrideRolloutPercentage;

    private string _channelTenantId = string.Empty;
    private string _channelValue = "Stable";

    private string _rollbackDatabaseKey = "ArchiveDB";
    private string _rollbackFlagName = string.Empty;
    private string _rollbackReason = string.Empty;
    private bool _rollbackHardDisable;

    private async Task SetRolloutPercentageAsync()
    {
        State.BeginOverrideSubmit();
        var result = await ApiClient.SetFeatureFlagRolloutPercentageAsync(_rolloutDatabaseKey, _rolloutFlagName, _rolloutPercentage);
        State.SetOverrideResult(result.IsSuccess
            ? $"{_rolloutFlagName} rollout percentage set to {(result.Data!.RolloutPercentage?.ToString() ?? "cleared")}."
            : DescribeFailure(result));
    }

    private async Task SetTenantOverrideAsync()
    {
        if (!Guid.TryParse(_tenantOverrideTenantId, out var tenantId))
        {
            State.SetOverrideResult("Enter a valid Tenant Id (GUID).");
            return;
        }

        State.BeginOverrideSubmit();
        var result = await ApiClient.SetTenantFeatureFlagOverrideAsync(_tenantOverrideFlagName, tenantId, _tenantOverrideEnabled, _tenantOverrideRolloutPercentage);
        State.SetOverrideResult(result.IsSuccess
            ? $"Tenant override for {_tenantOverrideFlagName} set: Enabled={result.Data!.Enabled}, Rollout={result.Data!.RolloutPercentage?.ToString() ?? "none"}."
            : DescribeFailure(result));
    }

    private async Task SetUserOverrideAsync()
    {
        if (!Guid.TryParse(_userOverrideUserId, out var userId))
        {
            State.SetOverrideResult("Enter a valid User Id (GUID).");
            return;
        }

        State.BeginOverrideSubmit();
        var result = await ApiClient.SetUserFeatureFlagOverrideAsync(_userOverrideFlagName, userId, _userOverrideEnabled);
        State.SetOverrideResult(result.IsSuccess
            ? $"User override for {_userOverrideFlagName} set: Enabled={result.Data!.Enabled}."
            : DescribeFailure(result));
    }

    private async Task SetRegionOverrideAsync()
    {
        State.BeginOverrideSubmit();
        var result = await ApiClient.SetRegionFeatureFlagOverrideAsync(_regionOverrideFlagName, _regionOverrideRegion, _regionOverrideEnabled, _regionOverrideRolloutPercentage);
        State.SetOverrideResult(result.IsSuccess
            ? $"Region override for {_regionOverrideFlagName} ({_regionOverrideRegion}) set: Enabled={result.Data!.Enabled}, Rollout={result.Data!.RolloutPercentage?.ToString() ?? "none"}."
            : DescribeFailure(result));
    }

    private async Task SetReleaseChannelAsync()
    {
        if (!Guid.TryParse(_channelTenantId, out var tenantId))
        {
            State.SetOverrideResult("Enter a valid Tenant Id (GUID).");
            return;
        }

        State.BeginOverrideSubmit();
        var result = await ApiClient.SetTenantReleaseChannelAsync(tenantId, _channelValue);
        State.SetOverrideResult(result.IsSuccess
            ? $"Tenant {tenantId} release channel set to {result.Data!.Channel}."
            : DescribeFailure(result));
    }

    private async Task TriggerRollbackAsync()
    {
        State.BeginOverrideSubmit();
        var result = await ApiClient.TriggerRollbackAsync(_rollbackDatabaseKey, _rollbackFlagName, _rollbackReason, _rollbackHardDisable);
        State.SetOverrideResult(result.IsSuccess
            ? $"Rollback executed for {result.Data!.FeatureName}: {result.Data!.TenantOverridesReset} tenant + {result.Data!.RegionOverridesReset} region overrides reset."
            : DescribeFailure(result));
    }

    private static string DescribeFailure<T>(PlantSafety.UI.Models.Common.ApiResponseEnvelope<T> envelope) =>
        envelope.IsProblem ? envelope.Problem!.Detail : $"Failed: {envelope.FaultType}";

    public void Dispose() => State.OnChange -= StateHasChanged;
}

@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Preventive Maintenance Schedule page (Volume M1 high-
     fidelity notes). List view of PM tasks with time/usage/condition
     triggers, color-coded overdue indicators. Built from the canonical
     Shared component library (DataGridComponent, StatusIndicatorComponent,
     ErrorBoundaryComponent, LoadingIndicatorComponent).
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/maintenance/preventive"

@inject PreventiveScheduleState State
@inject MaintenanceApiClient ApiClient
@inject NavigationState NavState

@implements IDisposable

@using PlantSafety.UI.Modules.Maintenance.ApiClients
@using PlantSafety.UI.Modules.Maintenance.Models
@using PlantSafety.UI.Modules.Maintenance.State

<PageTitle>Preventive Maintenance Schedule — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The preventive maintenance schedule could not be displayed." OnRetry="LoadAsync">

        <div class="ps-page-actions">
            <a href="/modules/maintenance" class="ps-btn ps-btn-ghost ps-btn-sm"><span class="bi bi-arrow-left" aria-hidden="true"></span> Back to Dashboard</a>
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadAsync" disabled="@State.IsLoading">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.ErrorMessage is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.ErrorMessage</div>
        }

        @if (State.IsLoading)
        {
            <LoadingIndicatorComponent Message="Loading preventive maintenance tasks…" />
        }
        else
        {
            <DataGridComponent TItem="PreventiveTaskDto"
                                Items="State.Tasks"
                                Headers="_headers"
                                KeySelector="t => t.TaskId"
                                EmptyMessage="No preventive maintenance tasks scheduled."
                                AriaLabel="Preventive maintenance tasks">
                <RowTemplate Context="task">
                    <td>@task.MachineCode</td>
                    <td>@task.Description</td>
                    <td>@task.TriggerType</td>
                    <td>@task.DueAtUtc.ToString("yyyy-MM-dd") UTC</td>
                    <td><StatusIndicatorComponent Status="@(task.IsOverdue ? "Critical" : "Healthy")" Label="@(task.IsOverdue ? "Overdue" : "On Schedule")" /></td>
                </RowTemplate>
            </DataGridComponent>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Machine", "Description", "Trigger", "Due", "Status"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Preventive Maintenance Schedule",
            activeModuleCode: "maintenance",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Maintenance", Href = RouteDefinitions.MaintenanceList },
                new BreadcrumbItem { Label = "Preventive Schedule" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        State.BeginLoad();
        var envelope = await ApiClient.GetPreventiveTasksAsync();

        if (envelope.IsSuccess)
            State.SetTasks(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetError(envelope.Problem!.Detail);
        else
            State.SetError($"Failed to load preventive maintenance tasks: {envelope.FaultType}");
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-08-05
   FILE DESCRIPTION: Create Work Order input form. Submits a
     CreateWorkOrderRequest via POST v1/maintenance/work-orders
     (MaintenanceApiClient.CreateWorkOrderAsync) and navigates to the new
     work order's detail page on success. Follows the canonical Blazor UI
     form pattern (EditForm/DataAnnotationsValidator/ValidationSummary)
     established by Financials/Pages/CreateBudgetPage.razor.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/maintenance/work-orders/new"

@inject CreateWorkOrderState State
@inject MaintenanceApiClient ApiClient
@inject TenantState TenantCtx
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.Maintenance.ApiClients
@using PlantSafety.UI.Modules.Maintenance.Models
@using PlantSafety.UI.Modules.Maintenance.State

<PageTitle>New Work Order — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Create Work Order form could not be displayed.">

        <div class="ps-detail-header">
            <h2 class="ps-detail-title">New Work Order</h2>
        </div>

        @if (State.CreateError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.CreateError</div>
        }

        <div class="ps-form-card">
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="ps-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="ps-form-error" />

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="work-order-code">Work Order Code</label>
                        <InputText id="work-order-code" @bind-Value="_model.WorkOrderCode" placeholder="e.g. WO-1042" maxlength="50" />
                        <ValidationMessage For="() => _model.WorkOrderCode" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="priority">Priority</label>
                        <InputSelect id="priority" @bind-Value="_model.Priority">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </InputSelect>
                        <ValidationMessage For="() => _model.Priority" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="machine-id">Machine ID</label>
                        <InputText id="machine-id" @bind-Value="_machineIdText" placeholder="Machine GUID" />
                        <ValidationMessage For="() => _model.MachineId" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="machine-code">Machine Code</label>
                        <InputText id="machine-code" @bind-Value="_model.MachineCode" placeholder="e.g. M-014" maxlength="50" />
                        <ValidationMessage For="() => _model.MachineCode" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="due-at">Due Date/Time (UTC)</label>
                        <InputDate id="due-at" Type="InputDateType.DateTimeLocal" @bind-Value="_model.DueAtUtc" />
                        <ValidationMessage For="() => _model.DueAtUtc" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field" style="flex:1 1 100%;">
                        <label class="ps-label" for="description">Description</label>
                        <InputTextArea id="description" @bind-Value="_model.Description" rows="4" maxlength="2000" />
                        <ValidationMessage For="() => _model.Description" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-actions">
                    <button type="submit" class="ps-btn ps-btn-primary" disabled="@State.IsCreating">
                        @if (State.IsCreating)
                        {
                            <span class="bi bi-arrow-repeat" aria-hidden="true"></span> <text>Creating…</text>
                        }
                        else
                        {
                            <span class="bi bi-check-circle" aria-hidden="true"></span> <text>Create Work Order</text>
                        }
                    </button>
                    <button type="button" class="ps-btn ps-btn-ghost" @onclick="NavigateToDashboard" disabled="@State.IsCreating">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>

    </ErrorBoundaryComponent>

</div>

@code {
    private readonly CreateWorkOrderRequest _model = new();
    private string _machineIdText = string.Empty;

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "New Work Order",
            activeModuleCode: "maintenance",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Maintenance", Href = RouteDefinitions.MaintenanceList },
                new BreadcrumbItem { Label = "New Work Order" }
            ]);

        State.Reset();
        _model.SiteId = TenantCtx.Tenant?.SiteId;

        State.OnChange += StateHasChanged;
    }

    private async Task SubmitAsync()
    {
        if (!Guid.TryParse(_machineIdText, out var machineId))
        {
            State.SetCreateError("Machine ID must be a valid GUID.");
            return;
        }

        _model.MachineId = machineId;

        State.BeginCreate();

        var envelope = await ApiClient.CreateWorkOrderAsync(_model);

        if (envelope.IsSuccess)
        {
            State.SetCreateSuccess(envelope.Data!.WorkOrderId);
            Nav.NavigateTo($"{RouteDefinitions.MaintenanceList}/work-orders/{envelope.Data!.WorkOrderId}");
        }
        else if (envelope.IsProblem)
        {
            State.SetCreateError(envelope.Problem!.Detail);
        }
        else
        {
            State.SetCreateError($"Failed to create work order: {envelope.FaultType}");
        }
    }

    private void NavigateToDashboard() => Nav.NavigateTo(RouteDefinitions.MaintenanceList);

    public void Dispose() => State.OnChange -= StateHasChanged;
}

@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Compliance dashboard page. KPI CardComponent grid
     summarizing Regulatory Requirements/Obligations/Tracking, followed by a
     TabControlComponent-driven three-tab DataGridComponent view of each
     read-model. Built entirely from the canonical Shared component library
     (ErrorBoundaryComponent, LoadingIndicatorComponent, CardComponent,
     TabControlComponent, DataGridComponent, StatusIndicatorComponent,
     DateRangePickerComponent, SearchBoxComponent, PaginationComponent).
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/compliance"

@inject ComplianceState State
@inject ComplianceApiClient ApiClient
@inject TenantState TenantCtx
@inject UserSessionState UserSession
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.Compliance.ApiClients
@using PlantSafety.UI.Modules.Compliance.Models
@using PlantSafety.UI.Modules.Compliance.State

<PageTitle>Compliance — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Compliance dashboard could not be displayed." OnRetry="LoadDashboardAsync">

        <div class="ps-page-actions">
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadDashboardAsync" disabled="@State.IsLoadingDashboard">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.DashboardError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.DashboardError</div>
        }

        @if (State.IsLoadingDashboard)
        {
            <LoadingIndicatorComponent Message="Loading compliance data…" />
        }
        else
        {
            <div class="ps-kpi-row">
                <CardComponent Title="Overdue Obligations" Subtitle="@State.OverdueObligationCount.ToString()" />
                <CardComponent Title="At-Risk / Overdue Tracking" Subtitle="@State.AtRiskTrackingCount.ToString()" />
                <CardComponent Title="Requirements Under Review" Subtitle="@State.UnderReviewRequirementCount.ToString()" />
                <CardComponent Title="Total Tracked Records" Subtitle="@((State.Requirements.Count + State.Obligations.Count + State.Tracking.Count).ToString())" />
            </div>

            <TabControlComponent Tabs="_tabLabels" ActiveIndex="_activeTab" ActiveIndexChanged="i => _activeTab = i" AriaLabel="Compliance sections" />

            <div class="ps-tab-panel" role="tabpanel">
                @if (_activeTab == 0)
                {
                    <DataGridComponent TItem="ComplianceRowViewModel"
                                        Items="State.RequirementsPageItems"
                                        Headers="_headers"
                                        KeySelector="r => r.ItemId"
                                        EmptyMessage="No regulatory requirements found."
                                        AriaLabel="Regulatory Requirements">
                        <RowTemplate Context="row">
                            <td>@row.Title</td>
                            <td>@row.Classifier</td>
                            <td><StatusIndicatorComponent Status="@row.StatusIndicatorState" Label="@row.Status" /></td>
                            <td>@row.RelevantDateLabel: @row.RelevantDateUtc.ToString("yyyy-MM-dd")</td>
                            <td><a href="@DetailHref(row)" class="ps-btn ps-btn-ghost ps-btn-sm">View</a></td>
                        </RowTemplate>
                    </DataGridComponent>
                    @if (State.RequirementsTotalPages > 1)
                    {
                        <PaginationComponent CurrentPage="State.RequirementsPage" TotalPages="State.RequirementsTotalPages"
                                              TotalCount="State.Requirements.Count" PageChanged="p => State.GoToRequirementsPage(p)" />
                    }
                }
                else if (_activeTab == 1)
                {
                    <DataGridComponent TItem="ComplianceRowViewModel"
                                        Items="State.ObligationsPageItems"
                                        Headers="_headers"
                                        KeySelector="r => r.ItemId"
                                        EmptyMessage="No compliance obligations found."
                                        AriaLabel="Obligations">
                        <RowTemplate Context="row">
                            <td>@row.Title</td>
                            <td>@row.Classifier</td>
                            <td><StatusIndicatorComponent Status="@row.StatusIndicatorState" Label="@row.Status" /></td>
                            <td>@row.RelevantDateLabel: @row.RelevantDateUtc.ToString("yyyy-MM-dd")</td>
                            <td><a href="@DetailHref(row)" class="ps-btn ps-btn-ghost ps-btn-sm">View</a></td>
                        </RowTemplate>
                    </DataGridComponent>
                    @if (State.ObligationsTotalPages > 1)
                    {
                        <PaginationComponent CurrentPage="State.ObligationsPage" TotalPages="State.ObligationsTotalPages"
                                              TotalCount="State.Obligations.Count" PageChanged="p => State.GoToObligationsPage(p)" />
                    }
                }
                else
                {
                    <DataGridComponent TItem="ComplianceRowViewModel"
                                        Items="State.TrackingPageItems"
                                        Headers="_headers"
                                        KeySelector="r => r.ItemId"
                                        EmptyMessage="No tracking items found."
                                        AriaLabel="Tracking">
                        <RowTemplate Context="row">
                            <td>@row.Title</td>
                            <td>@row.Classifier</td>
                            <td><StatusIndicatorComponent Status="@row.StatusIndicatorState" Label="@row.Status" /></td>
                            <td>@row.RelevantDateLabel: @row.RelevantDateUtc.ToString("yyyy-MM-dd")</td>
                            <td><a href="@DetailHref(row)" class="ps-btn ps-btn-ghost ps-btn-sm">View</a></td>
                        </RowTemplate>
                    </DataGridComponent>
                    @if (State.TrackingTotalPages > 1)
                    {
                        <PaginationComponent CurrentPage="State.TrackingPage" TotalPages="State.TrackingTotalPages"
                                              TotalCount="State.Tracking.Count" PageChanged="p => State.GoToTrackingPage(p)" />
                    }
                }
            </div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _tabLabels = ["Regulatory Requirements", "Obligations", "Tracking"];
    private static readonly string[] _headers = ["Title", "Classifier", "Status", "Date", "Actions"];
    private int _activeTab;

    private static string DetailHref(ComplianceRowViewModel row) =>
        $"{RouteDefinitions.ComplianceDashboard}/{row.Category}/{row.ItemId}";

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Compliance",
            activeModuleCode: "compliance",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Compliance" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        State.BeginDashboardLoad();

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var fromUtc = DateTime.UtcNow.AddYears(-2);
        var toUtc = DateTime.UtcNow.AddYears(2);

        var requirementsEnvelope = await ApiClient.GetRequirementsAsync(tenantId, null, fromUtc, toUtc);
        var obligationsEnvelope = await ApiClient.GetObligationsAsync(tenantId, null, fromUtc, toUtc);
        var trackingEnvelope = await ApiClient.GetTrackingAsync(tenantId, null, fromUtc, toUtc);

        if (requirementsEnvelope.IsSuccess && obligationsEnvelope.IsSuccess && trackingEnvelope.IsSuccess)
        {
            State.SetDashboardData(
                requirementsEnvelope.Data!.Items,
                obligationsEnvelope.Data!.Items,
                trackingEnvelope.Data!.Items);
        }
        else if (!requirementsEnvelope.IsSuccess)
        {
            State.SetDashboardError(DescribeFailure(requirementsEnvelope));
        }
        else if (!obligationsEnvelope.IsSuccess)
        {
            State.SetDashboardError(DescribeFailure(obligationsEnvelope));
        }
        else
        {
            State.SetDashboardError(DescribeFailure(trackingEnvelope));
        }
    }

    private static string DescribeFailure<T>(PlantSafety.UI.Models.Common.ApiResponseEnvelope<T> envelope) =>
        envelope.IsProblem ? envelope.Problem!.Detail : $"Failed to load: {envelope.FaultType}";

    public void Dispose() => State.OnChange -= StateHasChanged;
}

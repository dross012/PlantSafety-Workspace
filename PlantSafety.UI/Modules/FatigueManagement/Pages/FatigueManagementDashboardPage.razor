@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Fatigue Management dashboard. KPI risk-level summary +
     date-range-filterable, client-paginated grid, backed by the real
     GET /v1/operational/fatigue-management read-model endpoint.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/fatigue-management"

@inject FatigueManagementState State
@inject FatigueManagementApiClient ApiClient
@inject TenantState TenantCtx
@inject UserSessionState UserSession
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.FatigueManagement.State
@using PlantSafety.UI.Modules.FatigueManagement.ApiClients
@using PlantSafety.UI.Modules.FatigueManagement.Mappings
@using PlantSafety.UI.Modules.FatigueManagement.Models

<PageTitle>Fatigue Management — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Fatigue Management dashboard could not be displayed." OnRetry="LoadAsync">

        <div class="ps-page-actions">
            <DateRangePickerComponent StartDate="_startDate" EndDate="_endDate" RangeChanged="OnRangeChangedAsync" />
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadAsync" disabled="@State.IsLoading">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        <div class="ps-kpi-row">
            <CardComponent Title="High Risk" Subtitle="@State.HighRiskCount.ToString()" />
            <CardComponent Title="Medium Risk" Subtitle="@State.MediumRiskCount.ToString()" />
            <CardComponent Title="Low Risk" Subtitle="@State.LowRiskCount.ToString()" />
        </div>

        @if (State.Error is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.Error</div>
        }

        @if (State.IsLoading)
        {
            <LoadingIndicatorComponent Message="Loading fatigue management records…" />
        }
        else
        {
            <DataGridComponent TItem="FatigueManagementItemDto"
                                Items="PagedItems"
                                Headers="_headers"
                                KeySelector="f => f.FatigueRecordId"
                                EmptyMessage="No fatigue management records found for the selected date range."
                                AriaLabel="Fatigue management records">
                <RowTemplate Context="item">
                    @{ var vm = item.ToViewModel(); }
                    <td><SeverityBadgeComponent Severity="@vm.SeverityForBadge" Text="@item.FatigueRiskLevel" /></td>
                    <td class="ps-mono">@item.EmployeeId</td>
                    <td><StatusIndicatorComponent Status="@vm.OperationalStatus" Label="@item.Status" /></td>
                    <td>@item.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>
                        <a href="@RouteDefinitions.FatigueManagementDashboard/@item.FatigueRecordId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                    </td>
                </RowTemplate>
            </DataGridComponent>

            @if (TotalPages > 1)
            {
                <PaginationComponent CurrentPage="_currentPage" TotalPages="TotalPages" TotalCount="State.Items.Count" PageChanged="p => _currentPage = p" />
            }
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Risk Level", "Employee", "Status", "Recorded", "Actions"];
    private const int PageSize = 25;

    private DateOnly _startDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-30));
    private DateOnly _endDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private int _currentPage = 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(State.Items.Count / (double)PageSize));

    private IReadOnlyList<FatigueManagementItemDto> PagedItems =>
        State.Items.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Fatigue Management",
            activeModuleCode: "fatigue-management",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Fatigue Management" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private Task OnRangeChangedAsync((DateOnly Start, DateOnly End) range)
    {
        _startDate = range.Start;
        _endDate = range.End;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _currentPage = 1;
        State.BeginLoad();

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var envelope = await ApiClient.GetFatigueRecordsAsync(
            tenantId,
            siteId: null,
            fromUtc: _startDate.ToDateTime(TimeOnly.MinValue),
            toUtc: _endDate.ToDateTime(TimeOnly.MaxValue));

        if (envelope.IsSuccess)
            State.SetItems(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetError(envelope.Problem!.Detail);
        else
            State.SetError($"Failed to load fatigue management records: {envelope.FaultType}");
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

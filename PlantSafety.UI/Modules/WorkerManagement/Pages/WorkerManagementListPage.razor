@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Worker Management list page. Loads worker/employee
     records for a date range via WorkerManagementApiClient (CrossDomain
     Employees read-model), populates WorkerManagementState, and renders the
     worker grid with status indicators, search, date-range filtering, and
     client-side pagination (the source read-model is not server-paginated),
     built entirely from the canonical Shared component library
     (ErrorBoundaryComponent, LoadingIndicatorComponent, DateRangePickerComponent,
     SearchBoxComponent, DataGridComponent, StatusIndicatorComponent,
     PaginationComponent), following the Modules/Alerts exemplar pattern.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/worker-management"

@inject WorkerManagementState State
@inject WorkerManagementApiClient ApiClient
@inject NavigationState NavState
@inject TenantState TenantCtx
@inject UserSessionState UserSession

@implements IDisposable

@using PlantSafety.UI.Modules.WorkerManagement.ApiClients
@using PlantSafety.UI.Modules.WorkerManagement.Models
@using PlantSafety.UI.Modules.WorkerManagement.State

<PageTitle>Worker Management — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Worker Management list could not be displayed." OnRetry="LoadAsync">

        <div class="ps-page-actions">
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadAsync" disabled="@State.IsLoadingList">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        <DateRangePickerComponent StartDate="_startDate" EndDate="_endDate" RangeChanged="OnRangeChangedAsync" />
        <SearchBoxComponent Value="_searchText" Placeholder="Search by name, badge, or department" ValueChanged="OnSearchChangedAsync" />

        @if (State.ListError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.ListError</div>
        }

        @if (State.IsLoadingList)
        {
            <LoadingIndicatorComponent Message="Loading workers…" />
        }
        else
        {
            <DataGridComponent TItem="EmployeeItemDto"
                                Items="PagedItems"
                                Headers="_headers"
                                KeySelector="w => w.EmployeeId"
                                EmptyMessage="No workers found for the selected range/search."
                                AriaLabel="Workers">
                <RowTemplate Context="worker">
                    <td>@worker.FullName</td>
                    <td>@worker.EmployeeNumber</td>
                    <td>@worker.Department</td>
                    <td><StatusIndicatorComponent Status="@MapStatus(worker.Status)" Label="@worker.Status" /></td>
                    <td>@worker.HireDateUtc.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a href="@RouteDefinitions.WorkerManagementList/@worker.EmployeeId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                    </td>
                </RowTemplate>
            </DataGridComponent>

            <PaginationComponent CurrentPage="_currentPage" TotalPages="TotalPages" TotalCount="FilteredItems.Count" PageChanged="OnPageChangedAsync" />
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Name", "Badge #", "Department", "Status", "Hire Date", "Actions"];
    private const int PageSize = 25;

    private DateOnly _startDate = DateOnly.FromDateTime(DateTime.UtcNow.AddYears(-2));
    private DateOnly _endDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private string _searchText = string.Empty;
    private int _currentPage = 1;

    private IReadOnlyList<EmployeeItemDto> FilteredItems =>
        string.IsNullOrWhiteSpace(_searchText)
            ? State.Items
            : State.Items.Where(w =>
                    w.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    w.EmployeeNumber.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    w.Department.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItems.Count / (double)PageSize));

    private IReadOnlyList<EmployeeItemDto> PagedItems =>
        FilteredItems.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Worker Management",
            activeModuleCode: "worker-management",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Worker Management" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private Guid ResolveTenantId() => TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;

    private async Task LoadAsync()
    {
        State.BeginListLoad();
        var envelope = await ApiClient.GetEmployeesAsync(
            ResolveTenantId(),
            siteId: null,
            from: _startDate.ToDateTime(TimeOnly.MinValue),
            to: _endDate.ToDateTime(TimeOnly.MaxValue));

        if (envelope.IsSuccess && envelope.Data is { Success: true, Data: not null })
            State.SetItems(envelope.Data.Data.Items);
        else if (envelope.IsSuccess)
            State.SetListError(envelope.Data?.Errors is { Count: > 0 } errs ? string.Join("; ", errs) : "The Worker Management read-model returned no data.");
        else if (envelope.IsProblem)
            State.SetListError(envelope.Problem!.Detail);
        else
            State.SetListError($"Failed to load workers: {envelope.FaultType}");
    }

    private Task OnRangeChangedAsync((DateOnly Start, DateOnly End) range)
    {
        _startDate = range.Start;
        _endDate = range.End;
        _currentPage = 1;
        return LoadAsync();
    }

    private Task OnSearchChangedAsync(string text)
    {
        _searchText = text;
        _currentPage = 1;
        return Task.CompletedTask;
    }

    private Task OnPageChangedAsync(int page)
    {
        _currentPage = page;
        return Task.CompletedTask;
    }

    /// <summary>Maps an employment status to the closest StatusIndicatorComponent operational state.</summary>
    private static string MapStatus(string status) => status.ToLowerInvariant() switch
    {
        "active" => "Healthy",
        "onleave" or "on leave" => "Warning",
        "terminated" or "suspended" => "Critical",
        _ => "Offline",
    };

    public void Dispose() => State.OnChange -= StateHasChanged;
}

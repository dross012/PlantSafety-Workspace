@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Safety Programs list page. Generic list/filter template
     built from the canonical Shared component library (DataGridComponent,
     StatusIndicatorComponent, PaginationComponent, ErrorBoundaryComponent,
     LoadingIndicatorComponent), following the Alerts exemplar pattern.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/safety-programs"

@inject SafetyProgramsState State
@inject SafetyProgramsApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.SafetyPrograms.ApiClients
@using PlantSafety.UI.Modules.SafetyPrograms.Models
@using PlantSafety.UI.Modules.SafetyPrograms.State

<PageTitle>Safety Programs — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The safety programs list could not be displayed." OnRetry="LoadPageAsync">

        <div class="ps-page-actions">
            <label class="ps-field-label" for="program-status-filter">Status</label>
            <select id="program-status-filter" class="ps-btn ps-btn-ghost ps-btn-sm" @onchange="OnFilterChangedAsync">
                <option value="">All</option>
                <option value="Active">Active</option>
                <option value="Planned">Planned</option>
                <option value="OnHold">On Hold</option>
                <option value="Completed">Completed</option>
            </select>
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadPageAsync" disabled="@State.IsLoadingList">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        @if (State.ListError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.ListError</div>
        }

        @if (State.IsLoadingList)
        {
            <LoadingIndicatorComponent Message="Loading safety programs…" />
        }
        else
        {
            <DataGridComponent TItem="SafetyProgramListItemDto"
                                Items="State.Programs"
                                Headers="_headers"
                                KeySelector="p => p.ProgramId"
                                EmptyMessage="No safety programs found."
                                AriaLabel="Safety programs">
                <RowTemplate Context="program">
                    <td>@program.Name</td>
                    <td>@program.Category</td>
                    <td><StatusIndicatorComponent Status="@MapStatus(program.Status)" Label="@program.Status" /></td>
                    <td>@program.ParticipationPercent.ToString("F0")%</td>
                    <td>@program.OwnerName</td>
                    <td><a href="/modules/safety-programs/@program.ProgramId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a></td>
                </RowTemplate>
            </DataGridComponent>

            @if (State.TotalPages > 1)
            {
                <PaginationComponent CurrentPage="State.CurrentPage" TotalPages="State.TotalPages" TotalCount="State.TotalCount" PageChanged="GoToPageAsync" />
            }
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Program", "Category", "Status", "Participation", "Owner", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Safety Programs",
            activeModuleCode: "safety-programs",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Safety Programs" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadPageAsync();
    }

    private Task LoadPageAsync() => GoToPageAsync(1);

    private async Task GoToPageAsync(int page)
    {
        State.BeginListLoad();
        var envelope = await ApiClient.GetProgramsAsync(pageNumber: page, pageSize: 25, statusFilter: State.StatusFilter);

        if (envelope.IsSuccess)
            State.SetPrograms(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetListError(envelope.Problem!.Detail);
        else
            State.SetListError($"Failed to load safety programs: {envelope.FaultType}");
    }

    private async Task OnFilterChangedAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        State.SetStatusFilter(string.IsNullOrWhiteSpace(value) ? null : value);
        await GoToPageAsync(1);
    }

    private static string MapStatus(string status) => status.ToLowerInvariant() switch
    {
        "active" => "Healthy",
        "planned" => "Warning",
        "onhold" or "on hold" => "Warning",
        "completed" => "Offline",
        _ => "Offline",
    };

    public void Dispose() => State.OnChange -= StateHasChanged;
}

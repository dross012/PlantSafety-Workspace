@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-06-17
   UPDATED: 2026-08-05 — Repointed to the real, filterable
     GET v1/alerts/history endpoint (was calling a non-existent
     "GET v1/alerts" route) and added a Search filter bar (Site Id + UTC
     date range, both real GetAlertHistoryQuery parameters) plus a
     "New Alert" link to the Trigger form.
   FILE DESCRIPTION: Alerts list page. Loads the paginated alert history via
     AlertsApiClient, populates AlertsState, and renders the alert table with
     severity badges, status badges, filters, and pagination controls.
     Exemplar pattern for all module list pages.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/alerts"

@inject AlertsState State
@inject AlertsApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.Alerts.ApiClients
@using PlantSafety.UI.Modules.Alerts.Models

<PageTitle>Alerts — PlantSafety</PageTitle>

<div class="ps-page-container">

    <div class="ps-page-actions">
        <a href="@RouteDefinitions.AlertCreate" class="ps-btn ps-btn-primary ps-btn-sm">
            <span class="bi bi-plus-lg" aria-hidden="true"></span> New Alert
        </a>
        <button class="ps-btn ps-btn-ghost ps-btn-sm" @onclick="LoadPageAsync" disabled="@State.IsLoadingList">
            <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
        </button>
    </div>

    <CardComponent Title="Filters">
        <div class="ps-field-row">
            <label class="ps-field-label" for="filter-site">Site Id (optional)</label>
            <input id="filter-site" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_filterSiteId" placeholder="GUID" />
        </div>
        <div class="ps-field-row">
            <label class="ps-field-label" for="filter-from">From (UTC)</label>
            <input id="filter-from" type="date" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_filterFrom" />
        </div>
        <div class="ps-field-row">
            <label class="ps-field-label" for="filter-to">To (UTC)</label>
            <input id="filter-to" type="date" class="ps-btn ps-btn-ghost ps-btn-sm" style="text-align:left;" @bind="_filterTo" />
        </div>
        <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadPageAsync" disabled="@State.IsLoadingList">
            <span class="bi bi-search" aria-hidden="true"></span> Search
        </button>
    </CardComponent>

    @if (State.ListError is not null)
    {
        <div class="ps-alert ps-alert--danger" role="alert">@State.ListError</div>
    }

    @if (State.IsLoadingList)
    {
        <div class="ps-loading-panel" aria-live="polite" aria-busy="true">
            <div class="ps-spinner"></div>
            <span>Loading alerts…</span>
        </div>
    }
    else
    {
        <table class="ps-table" aria-label="Alerts">
            <thead>
                <tr>
                    <th scope="col">Severity</th>
                    <th scope="col">Title</th>
                    <th scope="col">Status</th>
                    <th scope="col">Source</th>
                    <th scope="col">Triggered</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alert in State.Alerts)
                {
                    <tr>
                        <td><span class="ps-badge ps-badge--@SeverityClass(alert.SeverityCode)">@alert.SeverityCode</span></td>
                        <td>@alert.Title</td>
                        <td>@alert.Status</td>
                        <td>@alert.SourceType</td>
                        <td>@alert.TriggeredAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td>
                            <a href="@RouteDefinitions.AlertsList/@alert.AlertId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a>
                        </td>
                    </tr>
                }
                @if (!State.Alerts.Any())
                {
                    <tr>
                        <td colspan="6" class="ps-table-empty">No alerts found.</td>
                    </tr>
                }
            </tbody>
        </table>

        @* ── Pagination ───────────────────────────────────────────────────────────── *@
        @if (State.TotalPages > 1)
        {
            <div class="ps-pagination" aria-label="Pagination">
                <button class="ps-btn ps-btn-ghost ps-btn-sm"
                        @onclick="() => GoToPageAsync(State.CurrentPage - 1)"
                        disabled="@(State.CurrentPage <= 1)">
                    <span class="bi bi-chevron-left" aria-hidden="true"></span> Prev
                </button>
                <span class="ps-pagination-info">Page @State.CurrentPage of @State.TotalPages (@State.TotalCount total)</span>
                <button class="ps-btn ps-btn-ghost ps-btn-sm"
                        @onclick="() => GoToPageAsync(State.CurrentPage + 1)"
                        disabled="@(State.CurrentPage >= State.TotalPages)">
                    Next <span class="bi bi-chevron-right" aria-hidden="true"></span>
                </button>
            </div>
        }
    }
</div>

@code {
    private string _filterSiteId = string.Empty;
    private DateOnly _filterFrom = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-90));
    private DateOnly _filterTo = DateOnly.FromDateTime(DateTime.UtcNow);

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Alerts",
            activeModuleCode: "alerts",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Alerts" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadPageAsync();
    }

    private async Task LoadPageAsync() => await GoToPageAsync(1);

    private async Task GoToPageAsync(int page)
    {
        State.BeginListLoad();

        var from = _filterFrom.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
        var to = _filterTo.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Utc);
        Guid? siteId = Guid.TryParse(_filterSiteId, out var parsedSiteId) ? parsedSiteId : null;

        var envelope = await ApiClient.GetAlertsAsync(from, to, siteId, pageNumber: page, pageSize: 25);

        if (envelope.IsSuccess)
            State.SetAlerts(envelope.Data!);
        else if (envelope.IsProblem)
            State.SetListError(envelope.Problem!.Detail);
        else
            State.SetListError($"Failed to load alerts: {envelope.FaultType}");
    }

    private static string SeverityClass(string severity) => severity.ToLowerInvariant() switch
    {
        "critical" => "critical",
        "high"     => "high",
        "medium"   => "medium",
        "low"      => "low",
        _          => "info"
    };

    public void Dispose() => State.OnChange -= StateHasChanged;
}

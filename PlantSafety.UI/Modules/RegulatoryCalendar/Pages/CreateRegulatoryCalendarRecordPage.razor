@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-08-05
   FILE DESCRIPTION: Create (generic) RegulatoryCalendar obligation input
     form. Submits a CreateRegulatoryCalendarRecordRequest via POST
     v1/compliance/regulatorycalendar
     (RegulatoryCalendarApiClient.CreateRegulatoryCalendarRecordAsync ->
     CreateRegulatoryCalendarCommand) and navigates to the new record's
     generic detail page on success. This is a distinct, generic
     RegulatoryCalendar aggregate from the 9 read-only Deadlines/Inspections/
     Renewals source verticals shown on RegulatoryCalendarListPage — those
     have no write commands; this is where Create/Activate/RecordCompliance/
     Close/Archive actually live. Follows the canonical Blazor UI form
     pattern established in CreateBudgetPage.razor.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/regulatory-calendar/new"

@inject RegulatoryCalendarState State
@inject RegulatoryCalendarApiClient ApiClient
@inject TenantState TenantCtx
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.RegulatoryCalendar.ApiClients
@using PlantSafety.UI.Modules.RegulatoryCalendar.Models
@using PlantSafety.UI.Modules.RegulatoryCalendar.State

<PageTitle>New Regulatory Obligation — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Create Obligation form could not be displayed.">

        <div class="ps-detail-header">
            <h2 class="ps-detail-title">New Regulatory Obligation</h2>
        </div>

        @if (State.CreateError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.CreateError</div>
        }

        <div class="ps-form-card">
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="ps-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="ps-form-error" />

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="event-title">Event Title</label>
                        <InputText id="event-title" @bind-Value="_model.EventTitle" />
                        <ValidationMessage For="() => _model.EventTitle" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="regulatory-body">Regulatory Body</label>
                        <InputText id="regulatory-body" @bind-Value="_model.RegulatoryBody" placeholder="e.g. OSHA, EPA, State DOL" />
                        <ValidationMessage For="() => _model.RegulatoryBody" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="jurisdiction-code">Jurisdiction Code</label>
                        <InputText id="jurisdiction-code" @bind-Value="_model.JurisdictionCode" placeholder="e.g. US-CA, US-FED" />
                        <ValidationMessage For="() => _model.JurisdictionCode" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="compliance-category">Compliance Category</label>
                        <InputText id="compliance-category" @bind-Value="_model.ComplianceCategory" placeholder="e.g. Reporting, Inspection, Renewal, Filing" />
                        <ValidationMessage For="() => _model.ComplianceCategory" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="responsible-party-id">Responsible Party Id</label>
                        <InputText id="responsible-party-id" @bind-Value="_responsiblePartyIdText" placeholder="GUID" />
                        <ValidationMessage For="() => _model.ResponsiblePartyId" class="ps-form-error" />
                    </div>

                    <div class="ps-field">
                        <label class="ps-label" for="reminder-lead-days">Reminder Lead Days</label>
                        <InputNumber id="reminder-lead-days" @bind-Value="_model.ReminderLeadDays" />
                        <ValidationMessage For="() => _model.ReminderLeadDays" class="ps-form-error" />
                    </div>
                </div>

                <div class="ps-form-row">
                    <div class="ps-field">
                        <label class="ps-label" for="due-at">Due Date (optional)</label>
                        <InputDate id="due-at" @bind-Value="_dueAt" />
                    </div>
                </div>

                <div class="ps-form-actions">
                    <button type="submit" class="ps-btn ps-btn-primary" disabled="@State.IsCreating">
                        @if (State.IsCreating)
                        {
                            <span class="bi bi-arrow-repeat" aria-hidden="true"></span> <text>Creating…</text>
                        }
                        else
                        {
                            <span class="bi bi-check-circle" aria-hidden="true"></span> <text>Create Obligation</text>
                        }
                    </button>
                    <button type="button" class="ps-btn ps-btn-ghost" @onclick="NavigateToList" disabled="@State.IsCreating">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>

    </ErrorBoundaryComponent>

</div>

@code {
    private readonly CreateRegulatoryCalendarRecordRequest _model = new();
    private string _responsiblePartyIdText = string.Empty;
    private DateTime? _dueAt;

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "New Regulatory Obligation",
            activeModuleCode: "regulatory-calendar",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Regulatory Calendar", Href = RouteDefinitions.RegulatoryCalendar },
                new BreadcrumbItem { Label = "New" }
            ]);

        State.ResetCreate();
        _model.SiteId = TenantCtx.Tenant?.SiteId;

        State.OnChange += StateHasChanged;
    }

    private async Task SubmitAsync()
    {
        State.BeginCreate();

        if (!Guid.TryParse(_responsiblePartyIdText, out var responsiblePartyId))
        {
            State.SetCreateError("Responsible Party Id must be a valid GUID.");
            return;
        }

        _model.ResponsiblePartyId = responsiblePartyId;
        _model.DueAtUtc = _dueAt.HasValue ? DateTime.SpecifyKind(_dueAt.Value, DateTimeKind.Utc) : null;

        var envelope = await ApiClient.CreateRegulatoryCalendarRecordAsync(_model);

        if (envelope.IsSuccess)
        {
            Nav.NavigateTo($"/modules/regulatory-calendar/record/{envelope.Data!.RegulatoryCalendarId}");
        }
        else if (envelope.IsProblem)
        {
            State.SetCreateError(envelope.Problem!.Detail);
        }
        else
        {
            State.SetCreateError($"Failed to create obligation: {envelope.FaultType}");
        }
    }

    private void NavigateToList() => Nav.NavigateTo(RouteDefinitions.RegulatoryCalendar);

    public void Dispose() => State.OnChange -= StateHasChanged;
}

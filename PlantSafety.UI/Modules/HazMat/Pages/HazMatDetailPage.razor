@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: HazMat detail page. The read-model API exposes only a
     list endpoint (GET api/v1/operational/hazardous-materials, no GetById)
     — the record is resolved from the already-loaded HazMatState.AllItems
     when navigated to from the list, or by re-querying a wide date window
     when deep-linked directly. Tabbed workspace built entirely from the
     canonical Shared component library: ErrorBoundaryComponent,
     LoadingIndicatorComponent, TabControlComponent, CardComponent,
     StatusIndicatorComponent.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/hazmat/{HazardousMaterialId:guid}"

@inject HazMatState State
@inject HazMatApiClient ApiClient
@inject NavigationState NavState
@inject NavigationManager Nav
@inject TenantState TenantCtx
@inject UserSessionState UserSession
@inject IJSRuntime JS

@implements IDisposable

@using PlantSafety.UI.Modules.HazMat.ApiClients
@using PlantSafety.UI.Modules.HazMat.Models
@using PlantSafety.UI.Modules.HazMat.Services
@using PlantSafety.UI.Modules.HazMat.State

<PageTitle>HazMat Detail — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The HazMat detail could not be displayed.">

        @if (State.IsLoadingDetail)
        {
            <LoadingIndicatorComponent Message="Loading hazardous materials record…" />
        }
        else if (State.DetailError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.DetailError</div>
        }
        else if (State.SelectedItem is { } record)
        {
            <div class="ps-detail-card">
            <div class="ps-detail-header">
                <h2 class="ps-detail-title">@record.MaterialName</h2>
                <span class="ps-chip">@record.HazardClass</span>
                <StatusIndicatorComponent Status="@HazMatUiService.MapStatusToOperationalState(record.Status)" Label="@record.Status" />
            </div>

            <TabControlComponent Tabs="_tabLabels" ActiveIndex="_activeTab" ActiveIndexChanged="OnTabChanged" AriaLabel="HazMat record sections" />

            <div class="ps-tab-panel" role="tabpanel">

                @if (_activeTab == 0)
                {
                    <CardComponent Title="Overview">
                        <div class="ps-field-row"><span class="ps-field-label">Material</span><span class="ps-field-value">@record.MaterialName</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Hazard Class</span><span><span class="ps-chip">@record.HazardClass</span></span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Status</span><span><StatusIndicatorComponent Status="@HazMatUiService.MapStatusToOperationalState(record.Status)" Label="@record.Status" /></span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Registered</span><span class="ps-field-value">@record.RegisteredAtUtc.ToString("u") UTC</span></div>
                    </CardComponent>
                }

                @if (_activeTab == 1)
                {
                    <CardComponent Title="Record Detail">
                        <div class="ps-field-row"><span class="ps-field-label">Record ID</span><span class="ps-field-value ps-mono">@record.HazardousMaterialId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Tenant ID</span><span class="ps-field-value ps-mono">@record.TenantId</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Site ID</span><span class="ps-field-value ps-mono">@(record.SiteId?.ToString() ?? "All sites")</span></div>
                        <div class="ps-field-row"><span class="ps-field-label">Registered By</span><span class="ps-field-value ps-mono">@record.RegisteredBy</span></div>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            SDS (Safety Data Sheet) attachment, storage/quantity tracking, and GHS pictograms
                            need backend wiring — the HazMat read-model endpoint returns only the summary
                            fields shown here today.
                        </p>
                    </CardComponent>
                }

                @if (_activeTab == 2)
                {
                    <CardComponent Title="Actions &amp; Audit">
                        <button class="ps-btn ps-btn-ghost ps-btn-sm" @onclick="() => Nav.NavigateTo(RouteDefinitions.HazMatList)">
                            <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to HazMat
                        </button>
                        <button class="ps-btn ps-btn-ghost ps-btn-sm" @onclick="PrintAsync">
                            <span class="bi bi-printer" aria-hidden="true"></span> Print
                        </button>
                        <button class="ps-btn ps-btn-primary ps-btn-sm" disabled aria-label="Log incident">
                            <span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Log Incident
                        </button>
                        <button class="ps-btn ps-btn-primary ps-btn-sm" disabled aria-label="Update inventory">
                            <span class="bi bi-box-seam" aria-hidden="true"></span> Update Inventory
                        </button>
                        <p class="ps-needs-backend">
                            <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                            Incident logging and inventory updates need backend wiring — no command endpoint
                            exists yet for the HazMat module (read-only today).
                        </p>
                    </CardComponent>
                }

            </div>
            </div>
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _tabLabels = ["Overview", "Record Detail", "Actions & Audit"];
    private int _activeTab;

    [Parameter] public Guid HazardousMaterialId { get; set; }

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "HazMat Detail",
            activeModuleCode: "hazmat",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "HazMat", Href = RouteDefinitions.HazMatList },
                new BreadcrumbItem { Label = "Detail" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ResolveRecordAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (State.SelectedItem is { } current && current.HazardousMaterialId == HazardousMaterialId)
            return;

        await ResolveRecordAsync();
    }

    private async Task ResolveRecordAsync()
    {
        State.BeginDetailLoad();

        var existing = State.AllItems.FirstOrDefault(i => i.HazardousMaterialId == HazardousMaterialId);
        if (existing is not null)
        {
            State.SetSelectedItem(existing);
            return;
        }

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var fromUtc = DateTime.UtcNow.AddYears(-2);
        var toUtc = DateTime.UtcNow;

        var envelope = await ApiClient.GetHazardousMaterialsAsync(tenantId, siteId: null, fromUtc, toUtc);

        if (envelope.IsSuccess)
        {
            var found = envelope.Data!.Items.FirstOrDefault(i => i.HazardousMaterialId == HazardousMaterialId);
            if (found is not null)
                State.SetSelectedItem(found);
            else
                State.SetDetailError("This hazardous materials record could not be found.");
        }
        else if (envelope.IsProblem)
        {
            State.SetDetailError(string.IsNullOrWhiteSpace(envelope.Problem!.Detail) ? "The request failed." : envelope.Problem!.Detail);
        }
        else
        {
            State.SetDetailError($"Failed to load hazardous materials record: {envelope.FaultType}");
        }
    }

    private Task OnTabChanged(int index)
    {
        _activeTab = index;
        return Task.CompletedTask;
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    public void Dispose() => State.OnChange -= StateHasChanged;
}

@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Contractor Management list page. KPI CardComponent row
     (Active/At-Risk), a SearchBoxComponent name filter, and a
     DataGridComponent listing of contractor records with
     StatusIndicatorComponent per row. Built entirely from the canonical
     Shared component library.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@page "/modules/contractor-management"

@inject ContractorManagementState State
@inject ContractorManagementApiClient ApiClient
@inject TenantState TenantCtx
@inject UserSessionState UserSession
@inject NavigationState NavState
@inject NavigationManager Nav

@implements IDisposable

@using PlantSafety.UI.Modules.ContractorManagement.ApiClients
@using PlantSafety.UI.Modules.ContractorManagement.Mappings
@using PlantSafety.UI.Modules.ContractorManagement.Models
@using PlantSafety.UI.Modules.ContractorManagement.State

<PageTitle>Contractor Management — PlantSafety</PageTitle>

<div class="ps-page-container">

    <ErrorBoundaryComponent Message="The Contractor Management list could not be displayed." OnRetry="LoadPageAsync">

        <div class="ps-page-actions">
            <button class="ps-btn ps-btn-primary ps-btn-sm" @onclick="LoadPageAsync" disabled="@State.IsLoadingList">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span> Refresh
            </button>
        </div>

        <div class="ps-kpi-row">
            <CardComponent Title="Active" Subtitle="@State.ActiveCount.ToString()" />
            <CardComponent Title="At Risk" Subtitle="@State.AtRiskCount.ToString()" />
            <CardComponent Title="Total Contractors" Subtitle="@State.Contractors.Count.ToString()" />
        </div>

        <SearchBoxComponent Value="State.SearchText" Placeholder="Search by contractor name" ValueChanged="text => State.SetSearchText(text)" />

        @if (State.ListError is not null)
        {
            <div class="ps-alert ps-alert--danger" role="alert">@State.ListError</div>
        }

        @if (State.IsLoadingList)
        {
            <LoadingIndicatorComponent Message="Loading contractors…" />
        }
        else
        {
            <DataGridComponent TItem="ContractorViewModel"
                                Items="State.PageItems"
                                Headers="_headers"
                                KeySelector="c => c.ContractorRecordId"
                                EmptyMessage="No contractor records found."
                                AriaLabel="Contractors">
                <RowTemplate Context="c">
                    <td>@c.ContractorName</td>
                    <td>@c.ServiceType</td>
                    <td><StatusIndicatorComponent Status="@c.StatusIndicatorState" Label="@c.Status" /></td>
                    <td>@c.OnboardedAtUtc.ToString("yyyy-MM-dd")</td>
                    <td><a href="@RouteDefinitions.ContractorManagementList/@c.ContractorRecordId" class="ps-btn ps-btn-ghost ps-btn-sm">View</a></td>
                </RowTemplate>
            </DataGridComponent>

            @if (State.TotalPages > 1)
            {
                <PaginationComponent CurrentPage="State.CurrentPage" TotalPages="State.TotalPages"
                                      TotalCount="State.FilteredCount" PageChanged="p => State.GoToPage(p)" />
            }
        }

    </ErrorBoundaryComponent>

</div>

@code {
    private static readonly string[] _headers = ["Contractor", "Service Type", "Status", "Onboarded", "Actions"];

    protected override void OnInitialized()
    {
        NavState.SetContext(
            pageTitle: "Contractor Management",
            activeModuleCode: "contractor-management",
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Home", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = "Contractor Management" }
            ]);

        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        State.BeginListLoad();

        var tenantId = TenantCtx.Tenant?.TenantId ?? UserSession.User.TenantId;
        var fromUtc = DateTime.UtcNow.AddYears(-2);
        var toUtc = DateTime.UtcNow.AddYears(2);

        var envelope = await ApiClient.GetContractorsAsync(tenantId, null, fromUtc, toUtc);

        if (envelope.IsSuccess)
        {
            State.SetContractors(envelope.Data!.Items.ToViewModels());
        }
        else if (envelope.IsProblem)
        {
            State.SetListError(envelope.Problem!.Detail);
        }
        else
        {
            State.SetListError($"Failed to load contractors: {envelope.FaultType}");
        }
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}

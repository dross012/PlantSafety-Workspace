@* ============================================================
   AUTHOR: PlantSafety Platform
   CREATED: 2026-07-14
   FILE DESCRIPTION: Shared "module coming online" placeholder page. Serves
     every module route that does not yet have a real content page so no
     Sub Menu link ever 404s. Other agents replace individual routes below
     with real module pages over time — when a module gets a real page, its
     route MUST be removed from the @page list below (zero-drift discipline).
     Routes are explicit and deterministic (no wildcard/reflection-based
     routing) per Blazor Hybrid Standards §8; the display label/icon for the
     matched route is resolved from ModuleRouteRegistry at runtime via the
     current NavigationManager URI, keeping this page in sync with the
     registry without needing 65 duplicated parameter bindings.
   SchemaVersion: 2026.1
   Additive-only evolution — see Enterprise Architectural Rule Handbook §XI
   ============================================================ *@

@* All 65 placeholder routes formerly listed here have been claimed by real
   module pages built out module-by-module (zero-drift discipline — see file
   header). This component is intentionally left unrouted; do not add a
   wildcard/catch-all route per Blazor Hybrid Standards §8. If a genuinely
   new, not-yet-built module route is introduced in the future, add its
   explicit @page directive back here as a temporary placeholder. *@

@inject NavigationState NavState
@inject NavigationManager Nav

<PageTitle>@ResolvedLabel — PlantSafety</PageTitle>

<div class="ps-page-container">
    <div class="ps-placeholder-panel">
        <span class="bi @ResolvedIcon ps-placeholder-icon" aria-hidden="true"></span>
        <h2>@ResolvedLabel</h2>
        <p class="ps-field-value">This module is coming online. Content, forms, and data views for
            <strong>@ResolvedLabel</strong> are being built out separately and will appear here.</p>
        <a href="@RouteDefinitions.Home" class="ps-btn ps-btn-ghost ps-btn-sm">
            <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to Main Menu
        </a>
    </div>
</div>

@code {
    private string ResolvedLabel { get; set; } = "Module";
    private string ResolvedIcon { get; set; } = "bi-box-seam";

    protected override void OnInitialized()
    {
        var relativePath = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var match = ModuleRouteRegistry.GetModuleByHref(relativePath);

        ResolvedLabel = match?.Label ?? "Module";
        ResolvedIcon = match?.IconClass ?? "bi-box-seam";

        NavState.SetContext(
            pageTitle: ResolvedLabel,
            activeModuleCode: match?.ModuleCode ?? string.Empty,
            breadcrumbs:
            [
                new BreadcrumbItem { Label = "Main Menu", Href = RouteDefinitions.Home },
                new BreadcrumbItem { Label = ResolvedLabel }
            ]);
    }
}

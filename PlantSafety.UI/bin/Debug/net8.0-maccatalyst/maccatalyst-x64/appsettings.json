{
  "Api": {
    "BaseUrl": "https://plantsafety-api.yourdomain.com/api/",
    "TimeoutSeconds": 30
  },
  "AzureAd": {
    "Authority": "https://login.microsoftonline.com/{TenantId}",
    "ClientId": "{AzureAdClientId}",
    "Scopes": "api://{AzureAdClientId}/access_as_user"
  },
  "Telemetry": {
    "ConnectionString": "{AppInsightsConnectionString}",
    "Enabled": true
  },
  "Features": {
    "DiagnosticsViewer": true
  }
}

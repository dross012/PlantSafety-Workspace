<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn)</NoWarn>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <LangVersion>12</LangVersion>
    <Optimize>true</Optimize>
    <AssemblyName>PlantSafety.Application</AssemblyName>
    <RootNamespace>PlantSafety.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlantSafety.Domain\PlantSafety.Domain.csproj" />
    <ProjectReference Include="..\PlantSafety.SharedKernel\PlantSafety.SharedKernel.csproj" />
    <!-- Shared.AuditLogging.Abstractions: the canonical read contract (IAuditLogRepository,
         AuditLogEntry, AuditLogSearchCriteria, AuditLogSearchResult) for the shared,
         cross-database [PlantSafety.AuditDB].dbo.AuditLog table, extracted 2026-07-26 so
         PlantSafety and Reporting both consume the same contract; see
         Shared\AuditLogging\docs\README.md. -->
    <ProjectReference Include="..\..\Shared\AuditLogging\Shared.AuditLogging.Abstractions\Shared.AuditLogging.Abstractions.csproj" />
    <ProjectReference Include="..\..\Shared\Authorization\Shared.Authorization.Abstractions\Shared.Authorization.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": {
    "Name": "Production",
    "FeatureFlags": {
      "EnableOpenApi": false
    },
    "ConnectionStrings": {},
    "Secrets": {},
    "RuntimeLimits": {
      "MaxRequestBodySizeBytes": 10485760,
      "RequestTimeoutSeconds": 30,
      "MaxConcurrentRequests": 100
    }
  }
}

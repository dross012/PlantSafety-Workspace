# ============================================================================
# .gitignore -- standard .NET build output + tooling artifacts.
# Matches the convention used by the parent PlantSafety workspace tree.
#
# Added 2026-08-10 during the .NET 10 migration: this repo had no .gitignore,
# so bin/obj output and IDE caches were visible to (and in some repos already
# committed by) git, drowning real diffs in build noise.
# ============================================================================

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / IntelliJ
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# MSBuild / dotnet
*.binlog
*.dotCover

# OS files
.DS_Store
Thumbs.db

# Rider/VS temp
*.tmp
*.bak
*.swp
*~

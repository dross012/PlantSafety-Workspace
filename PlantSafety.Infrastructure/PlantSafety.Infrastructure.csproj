         Shared\AuditLogging\docs\README.md. -->
    <ProjectReference Include="..\..\Shared\AuditLogging\Shared.AuditLogging.Infrastructure\Shared.AuditLogging.Infrastructure.csproj" />
    <!-- Shared.EventBus.Infrastructure: cross-module SQL-queue-backed event bus (separate
         from Shared.AuditLogging and from this project's own intra-module Outbox ->
         MassTransit/RabbitMq pipeline). See Messaging\CrossModule\ and
         Shared\EventBus\docs\README.md. -->
    <ProjectReference Include="..\..\Shared\EventBus\Shared.EventBus.Infrastructure\Shared.EventBus.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\EventBus\Shared.DomainEvents.Abstractions\Shared.DomainEvents.Abstractions.csproj" />
